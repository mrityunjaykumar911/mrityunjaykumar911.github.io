---
interface Props {
  signals: string[];
}

const { signals } = Astro.props;
---

<section class="signal-strip" aria-label="At a glance">
  {signals.map((s) => <p>{s}</p>)}
</section>

<style>
  .signal-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    min-height: 84px;
    padding: 0 var(--gutter);
    background: var(--panel);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .signal-strip p {
    margin: 0;
    padding: 14px 24px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    color: inherit;
  }

  .signal-strip p + p {
    border-left: 1px solid var(--line);
  }

  @media (min-width: 1800px) {
    .signal-strip {
      min-height: 108px;
    }

    .signal-strip p {
      font-size: 16px;
    }
  }

  @media (max-width: 900px) {
    .signal-strip {
      grid-template-columns: 1fr;
      padding: 0;
    }

    .signal-strip p + p {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
