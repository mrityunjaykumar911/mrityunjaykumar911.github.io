---
import Icon from './Icon.astro';
import type { Link } from '../data/schema';

interface Props {
  heading: string;
  links: Link[];
}

const { heading, links } = Astro.props;
const isExternal = (href: string) => href.startsWith('http');
const iconFor = (label: string) => (label === 'Résumé' ? 'download' : 'arrow-up-right');
---

<section class="contact-section" aria-labelledby="contact-title">
  <p class="eyebrow">Let's compare notes</p>
  <h2 id="contact-title">{heading}</h2>

  <div class="contact-links">
    {
      links.map((link) => (
        <a
          href={link.href}
          target={isExternal(link.href) ? '_blank' : undefined}
          rel={isExternal(link.href) ? 'noreferrer' : undefined}
        >
          {link.label} <Icon name={iconFor(link.label)} size={16} />
        </a>
      ))
    }
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    overflow: hidden;
    padding: clamp(76px, 11vw, 140px) var(--gutter);
    background: var(--coral);
    color: #fff;
  }

  .contact-section::after {
    content: '@';
    position: absolute;
    right: -30px;
    bottom: -160px;
    color: rgba(255, 255, 255, 0.11);
    font-family: var(--serif);
    font-size: 390px;
    line-height: 1;
    pointer-events: none;
  }

  .contact-section .eyebrow {
    margin-bottom: 14px;
  }

  .contact-section h2 {
    position: relative;
    z-index: 1;
    max-width: 20ch;
    font-family: var(--serif);
    font-size: clamp(40px, 5vw, 68px);
    line-height: 1.02;
  }

  .contact-links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 44px;
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 48px;
    padding: 0 20px;
    border: 1px solid rgba(255, 255, 255, 0.75);
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .contact-links a:hover {
    background: #fff;
    color: var(--coral);
  }

  @media (max-width: 620px) {
    .contact-links,
    .contact-links a {
      width: 100%;
    }

    .contact-links a {
      justify-content: space-between;
    }
  }
</style>
