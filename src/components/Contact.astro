---
import Icon from './Icon.astro';
import type { Link } from '../data/schema';

interface Props {
  links: Link[];
}

const { links } = Astro.props;
const isExternal = (href: string) => href.startsWith('http');
const opensNewTab = (href: string) => isExternal(href) || href.endsWith('.pdf');
const iconFor = (label: string) => (label === 'Résumé' ? 'download' : 'arrow-up-right');
const reverseEmail = (href: string) => href.replace(/^mailto:/, '').split('').reverse().join('');
const contactPriority = new Map([
  ['mail', 0],
  ['linkedin', 1],
  ['github', 2],
  ['file', 3],
]);
const orderedLinks = [...links].sort(
  (a, b) => (contactPriority.get(a.icon) ?? 99) - (contactPriority.get(b.icon) ?? 99)
);
---

<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <h2 id="contact-title">Contact</h2>

  <div class="contact-links">
    {
      orderedLinks.map((link) => (
        <a
          href={link.icon === 'mail' ? '#contact-email' : link.href}
          id={link.icon === 'mail' ? 'contact-email' : undefined}
          data-email-reversed={link.icon === 'mail' ? reverseEmail(link.href) : undefined}
          target={opensNewTab(link.href) ? '_blank' : undefined}
          rel={opensNewTab(link.href) ? 'noreferrer' : undefined}
          download={link.icon === 'file' ? '' : undefined}
        >
          {link.label} <Icon name={iconFor(link.label)} size={16} />
        </a>
      ))
    }
    <noscript>
      <p class="contact-noscript">Enable JavaScript to reveal my email address, or use the résumé PDF above.</p>
    </noscript>
  </div>
</section>

<script>
  const emailLink = document.querySelector<HTMLAnchorElement>('[data-email-reversed]');
  const reversedEmail = emailLink?.dataset.emailReversed;

  if (emailLink && reversedEmail) {
    emailLink.href = `mailto:${[...reversedEmail].reverse().join('')}`;
  }
</script>

<style>
  .contact-section {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 32px;
    width: var(--content);
    margin: 0 auto;
    padding: 40px 0;
    border-top: 1px solid var(--line-strong);
    color: var(--ink);
  }

  .contact-section h2 {
    font: 580 30px/1.2 var(--display);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    color: var(--accent-strong);
    text-underline-offset: 4px;
  }

  .contact-links a:hover {
    text-decoration-thickness: 2px;
  }

  .contact-noscript {
    width: 100%;
    margin-top: 8px;
    color: var(--ink-soft);
    font-size: 14px;
  }

</style>
