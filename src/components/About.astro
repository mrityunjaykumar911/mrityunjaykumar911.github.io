---
import type { Capability, Resume } from '../data/schema';
import { formatRange, inlineMarkup } from '../lib/text';
import { withBase } from '../lib/url';

interface Props {
  id: string;
  paragraphs: string[];
  capabilities: Capability[];
  education: Resume['education'];
  compact?: boolean;
}

const { id, paragraphs, capabilities, education, compact = false } = Astro.props;
---

{compact ? (
  <section class="backstory" id={id} aria-labelledby={`${id}-title`}>
    <h2 id={`${id}-title`}>Background</h2>
    <div>
      <p>I have worked across the stack for more than ten years. At MediaTek I wrote embedded audio and Bluetooth software for feature phones. At Talentica I built data and ML systems: a C++ delta-sync service, a financial-document search engine, and real-time ML pipelines on Storm and Kafka.</p>
      <p>A master's at Stony Brook turned that into distributed systems research. That led to storage recovery at VMware, and now to infrastructure for AI agents at Microsoft.</p>
      <a href={withBase('/latest.html')}>Detailed résumé</a>
    </div>
  </section>
) : (
<section class="section about-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-heading reveal">
    <p class="eyebrow">03 / Background</p>
    <div class="heading-body">
      <h2 id={`${id}-title`}>Across the systems stack.</h2>
    </div>
  </div>

  <div class="about-grid">
    <div class="about-copy reveal">
      {paragraphs.map((p) => <p set:html={inlineMarkup(p)} />)}
    </div>

    <dl class="capabilities reveal" role="group" aria-label="Core capability matrix">
      {
        capabilities.map((cap) => (
          <div class="capability">
            <dt class="mono-label">{cap.label}</dt>
            <dd>{cap.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="education reveal" aria-label="Education">
    <p class="mono-label education-label">Education</p>
    <ul class="education-list">
      {
        education.map((school) => (
          <li class="education-item">
            <p class="education-degree">{school.degree}</p>
            <p class="education-school">{school.school}</p>
            <p class="education-meta">
              <time datetime={school.start}>{formatRange(school.start, school.end)}</time>
              <span aria-hidden="true"> · </span>{school.location}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
)}

<style>
  .backstory { width: var(--content); margin: 0 auto; padding: 48px 0; border-top: 1px solid var(--line-strong); display: grid; grid-template-columns: minmax(160px, .42fr) minmax(0, 1fr); gap: var(--grid-gap); }
  .backstory h2 { font: 580 30px/1.2 var(--display); }
  .backstory p { max-width: 62ch; font-size: 19px; line-height: 1.5; }
  .backstory p + p { margin-top: 12px; }
  .backstory a { display: inline-flex; align-items: center; min-height: 44px; margin-top: 6px; color: var(--accent-strong); text-underline-offset: 4px; }
  @media (max-width: 700px) { .backstory { grid-template-columns: 1fr; gap: 12px; padding: 32px 0; } }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.85fr);
    gap: var(--grid-gap);
    align-items: start;
  }

  .about-copy {
    max-width: 60ch;
    font-family: var(--display);
    font-size: 23px;
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: 0;
    color: var(--ink);
  }

  .about-copy p {
    margin: 0 0 var(--s4);
  }

  .about-copy p:last-child {
    margin-bottom: 0;
  }

  .about-copy strong {
    color: var(--accent);
    font-weight: 620;
  }

  .capabilities {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--line);
    margin: 0;
  }

  .capability {
    display: grid;
    grid-template-columns: minmax(120px, 0.35fr) 1fr;
    gap: 24px;
    min-height: 0;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .capability dt {
    margin: 0;
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .capability dd {
    margin: 0;
    font-size: 15px;
  }

  .education {
    margin-top: var(--s6);
    padding-top: var(--s5);
    border-top: 1px solid var(--line);
  }

  .education-label {
    margin-bottom: var(--s3);
    color: var(--accent);
  }

  .education-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s4);
  }

  .education-degree {
    margin: 0;
    font-family: var(--display);
    font-size: 18px;
    font-weight: 620;
    letter-spacing: 0;
  }

  .education-school {
    margin: 4px 0 0;
    color: var(--ink);
    font-size: 15px;
  }

  .education-meta {
    margin: 8px 0 0;
    color: var(--ink-faint);
    font-size: 14px;
  }

  @media (min-width: 1800px) {
    .about-copy {
      font-size: 28px;
    }

    .capability {
      grid-template-columns: minmax(180px, 0.35fr) 1fr;
      padding: 26px 0;
    }

    .capability dt {
      font-size: 14px;
    }

    .capability dd {
      font-size: 18px;
    }
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .about-copy {
      text-align: left;
      font-size: 21px;
    }

    .capability {
      grid-template-columns: 1fr;
      gap: 8px;
      justify-items: start;
      text-align: left;
    }

    .education {
      text-align: left;
    }

    .education-list {
      grid-template-columns: 1fr;
      gap: var(--s3);
    }
  }
</style>
