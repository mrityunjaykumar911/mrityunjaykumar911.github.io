---
import type { Capability } from '../data/schema';
import { inlineMarkup } from '../lib/text';

interface Props {
  id: string;
  paragraphs: string[];
  capabilities: Capability[];
}

const { id, paragraphs, capabilities } = Astro.props;
---

<section class="section about-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-heading reveal">
    <p class="eyebrow">About</p>
    <div class="heading-body">
      <h2 id={`${id}-title`}>How I approach systems work.</h2>
    </div>
  </div>

  <div class="about-grid">
    <div class="about-copy reveal">
      {paragraphs.map((p) => <p set:html={inlineMarkup(p)} />)}
    </div>

    <dl class="capabilities reveal" role="group" aria-label="Core capability matrix">
      {
        capabilities.map((cap) => (
          <div class="capability">
            <dt class="mono-label">{cap.label}</dt>
            <dd>{cap.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.85fr);
    gap: var(--grid-gap);
    align-items: start;
  }

  .about-copy {
    max-width: 60ch;
    font-family: var(--display);
    font-size: clamp(20px, 1.7vw, 24px);
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -0.016em;
    color: var(--ink);
  }

  .about-copy p {
    margin: 0 0 var(--s4);
  }

  .about-copy p:last-child {
    margin-bottom: 0;
  }

  .about-copy strong {
    color: var(--accent);
    font-weight: 620;
  }

  .capabilities {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--line);
    margin: 0;
  }

  .capability {
    display: grid;
    grid-template-columns: minmax(120px, 0.35fr) 1fr;
    gap: 24px;
    min-height: 0;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .capability dt {
    margin: 0;
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .capability dd {
    margin: 0;
    font-size: 15px;
  }

  @media (min-width: 1800px) {
    .about-copy {
      font-size: 28px;
    }

    .capability {
      grid-template-columns: minmax(180px, 0.35fr) 1fr;
      padding: 26px 0;
    }

    .capability dt {
      font-size: 14px;
    }

    .capability dd {
      font-size: 18px;
    }
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .capability {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
