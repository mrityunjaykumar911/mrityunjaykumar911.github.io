---
import { withBase } from '../lib/url';

interface Props {
  name: string;
  year: number;
}

const { name, year } = Astro.props;
---

<footer class="site-footer">
  <p>© {year} {name}</p>
  <nav aria-label="Footer">
    <a href={withBase('/')}>Home</a>
    <a href={withBase('/method.html')}>Research notes</a>
    <a href="https://github.com/mrityunjaykumar911/mrityunjaykumar911.github.io" target="_blank" rel="noreferrer">Source</a>
  </nav>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    width: var(--content);
    margin: 0 auto;
    padding: 24px 0 40px;
    border-top: 1px solid var(--line-strong);
    color: var(--ink-soft);
    font: 15px/1.5 var(--sans);
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-soft);
    text-underline-offset: 4px;
  }

  .site-footer a:hover {
    color: var(--ink);
  }
</style>
