---
import Icon from './Icon.astro';
import { resume } from '../data/resume';
import { withBase } from '../lib/url';

interface Props {
  name?: string;
  resumePdf?: string;
  nav?: { href: string; label: string }[];
  homeHref?: string;
}

const {
  name = resume.profile.name,
  resumePdf = withBase(resume.profile.resumePdf),
  nav = [
    { href: withBase('/#work'), label: 'Engineering' },
    { href: withBase('/#research'), label: 'Writing' },
    { href: withBase('/#about'), label: 'About' },
    { href: withBase('/#contact'), label: 'Contact' },
  ],
  homeHref = '#top',
} = Astro.props;
---

<header class="site-header" id="top">
  <a class="wordmark" href={homeHref}>{name}</a>

  <button
    class="menu-button"
    type="button"
    aria-expanded="false"
    aria-controls="site-nav"
    data-menu-button
  >
    <Icon name="menu" size={20} />
    <span class="sr-only">Open navigation</span>
  </button>

  <nav class="site-nav" id="site-nav" aria-label="Primary" data-site-nav>
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href={resumePdf} download target="_blank" rel="noreferrer">Résumé</a>
  </nav>
</header>

<noscript>
  <style is:inline>
    .site-header .menu-button { display: none !important; }
    .site-header .site-nav { position: static !important; display: flex !important; flex-direction: row !important; flex-wrap: wrap; gap: 8px 20px !important; padding: 0 !important; border: 0 !important; background: transparent !important; }
  </style>
</noscript>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const navigation = document.querySelector<HTMLElement>('[data-site-nav]');

  if (menuButton && navigation) {
    const setOpen = (open: boolean) => {
      menuButton.setAttribute('aria-expanded', String(open));
      navigation.classList.toggle('is-open', open);
      const label = menuButton.querySelector('.sr-only');
      if (label) label.textContent = open ? 'Close navigation' : 'Open navigation';
    };
    menuButton.addEventListener('click', () =>
      setOpen(menuButton.getAttribute('aria-expanded') !== 'true')
    );
    navigation.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        menuButton.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    width: var(--content);
    min-height: 72px;
    margin: 0 auto;
    border-bottom: 1px solid var(--line-strong);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font: 600 18px/1.2 var(--display);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font: 500 15px/1.4 var(--sans);
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='true'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .menu-button {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  @media (max-width: 760px) {
    .menu-button {
      display: grid;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      z-index: 20;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 0 16px;
      border-bottom: 1px solid var(--line-strong);
      background: var(--paper);
    }

    .site-nav.is-open {
      display: flex;
    }
  }
</style>
