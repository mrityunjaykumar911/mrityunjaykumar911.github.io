---
import { formatRange, inlineMarkup } from '../lib/text';
import type { Role } from '../data/schema';

interface Props {
  id: string;
  roles: Role[];
}

const { id, roles } = Astro.props;

const monogram = (name: string) => {
  const words = name.split(/\s+/).filter(Boolean);
  return (words.length > 1 ? words[0][0] + words[1][0] : name.slice(0, 2)).toUpperCase();
};
---

<section class="section work-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-heading reveal">
    <p class="eyebrow">Selected experience</p>
    <div class="heading-body">
      <h2 id={`${id}-title`}>Engineering for the real world.</h2>
      <p class="section-lede">
        From user-facing productivity software to crash-consistent storage, I work
        where reliability and scale are product features.
      </p>
    </div>
  </div>

  <ol class="experience-list">
    {
      roles.map((role) => (
        <li class="experience reveal">
          <div class="experience-head">
            <span class="company-chip" aria-hidden="true">{monogram(role.company)}</span>
            <h3 class="role">{role.role}</h3>
            <p class="org">
              <span class="company">{role.company}</span>
              <span class="org-sep" aria-hidden="true">·</span>
              <time datetime={role.start}>{formatRange(role.start, role.end)}</time>
              <span class="org-sep" aria-hidden="true">·</span>
              <span>{role.location}</span>
            </p>
          </div>

          <div class="experience-body">
            <p class="experience-summary prose" set:html={inlineMarkup(role.summary)} />

            {role.lead.length > 0 && (
              <div class="experience-evidence">
                <p class="evidence-label">Accomplishments</p>
                <ul class="experience-lead prose">
                  {role.lead.map((b) => (
                    <li set:html={inlineMarkup(b)} />
                  ))}
                </ul>
              </div>
            )}

            {role.detail.length > 0 && (
              <details class="experience-more">
                <summary>
                  <span class="more-open">Full detail</span>
                  <span class="more-close">Hide detail</span>
                </summary>
                <div class="experience-detail">
                  {role.detail.map((group) => (
                    <div class="detail-group">
                      {group.title && <p class="detail-title mono-label">{group.title}</p>}
                      <ul class="prose">
                        {group.bullets.map((b) => (
                          <li set:html={inlineMarkup(b)} />
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </details>
            )}

            {role.tags.length > 0 && (
              <ul class="tag-list" aria-label="Areas of work">
                {role.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .experience-list {
    list-style: none;
  }

  .experience {
    position: relative;
    display: grid;
    grid-template-columns: var(--grid-col) minmax(0, 1fr);
    gap: var(--grid-gap);
    align-items: start;
    padding: var(--s6) 0;
    border-top: 1px solid var(--line);
  }

  .experience:first-child {
    border-top: 1px solid var(--line-strong);
  }

  .experience:last-child {
    border-bottom: 1px solid var(--line);
  }

  .experience-head {
    position: sticky;
    top: 108px;
  }

  .company-chip {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--s2);
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    font-size: 14px;
    font-weight: 640;
    letter-spacing: 0.02em;
  }

  .experience-head .role {
    font-family: var(--display);
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 640;
    line-height: 1.1;
    letter-spacing: -0.022em;
  }

  .experience-head .org {
    margin-top: var(--s1);
    color: var(--ink-soft);
    font-size: 15px;
  }

  .experience-head .company {
    color: var(--ink);
    font-weight: 560;
  }

  .experience-head .org-sep {
    margin: 0 8px;
    color: var(--ink-faint);
  }

  .experience-body {
    max-width: 68ch;
  }

  .evidence-label {
    margin-bottom: var(--s2);
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .experience-summary {
    color: var(--ink);
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.6;
  }

  .experience-evidence {
    margin-top: var(--s5);
  }

  .experience-lead {
    list-style: none;
    display: grid;
    gap: var(--s2);
  }

  .experience-lead li {
    position: relative;
    padding-left: 24px;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.6;
  }

  .experience-lead li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.66em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .experience-more {
    margin-top: 16px;
  }

  .experience-more summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 520;
    color: var(--accent);
    cursor: pointer;
    list-style: none;
  }

  .experience-more summary::-webkit-details-marker {
    display: none;
  }

  .experience-more summary::after {
    content: '+';
    font-size: 14px;
  }

  .experience-more[open] summary::after {
    content: '–';
  }

  .more-close {
    display: none;
  }

  .experience-more[open] .more-open {
    display: none;
  }

  .experience-more[open] .more-close {
    display: inline;
  }

  .experience-detail {
    display: grid;
    gap: 18px;
    margin-top: 16px;
    max-width: 66ch;
  }

  .detail-title {
    margin-bottom: 6px;
    color: var(--accent);
  }

  .experience-detail ul {
    list-style: none;
    display: grid;
    gap: 7px;
  }

  .experience-detail li {
    position: relative;
    padding-left: 18px;
    color: var(--ink-soft);
    font-size: 15px;
  }

  .experience-detail li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 1px;
    background: var(--line);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin-top: 24px;
  }

  .tag-list li {
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
  }

  @media (min-width: 1800px) {
    .experience {
      padding: var(--s7) 0;
    }

    .experience-head .org,
    .evidence-label,
    .experience-more summary,
    .tag-list li {
      font-size: 15px;
    }

    .experience-head .role {
      font-size: 40px;
    }

    .experience-summary {
      font-size: 21px;
    }

    .experience-lead li,
    .experience-detail li {
      font-size: 18px;
    }
  }

  @media (max-width: 620px) {
    .experience {
      grid-template-columns: 1fr;
      gap: var(--s4);
      padding: 32px 0 36px;
    }

    .experience-head {
      position: static;
    }
  }

  @media (min-width: 621px) and (max-width: 900px) {
    .experience {
      grid-template-columns: minmax(190px, 0.4fr) minmax(0, 1fr);
      gap: var(--s4);
    }
  }
</style>
