---
import { formatRange, inlineMarkup } from '../lib/text';
import type { Role } from '../data/schema';

interface Props {
  id: string;
  roles: Role[];
}

const { id, roles } = Astro.props;
---

<section class="section work-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-heading reveal">
    <p class="section-number">02</p>
    <div>
      <p class="eyebrow">Selected experience</p>
      <h2 id={`${id}-title`}>Engineering for the real world.</h2>
    </div>
    <p class="section-lede">
      From user-facing productivity software to crash-consistent storage, I work
      where reliability and scale are product features.
    </p>
  </div>

  <ol class="experience-list">
    {
      roles.map((role) => (
        <li class="experience reveal">
          <div class="experience-meta">
            <p class="company">{role.company}</p>
            <p>
              <time datetime={role.start}>{formatRange(role.start, role.end)}</time>
            </p>
          </div>

          <div class="experience-body">
            <h3>{role.role}</h3>
            <p class="evidence-label">Summary</p>
            <p class="experience-summary prose" set:html={inlineMarkup(role.summary)} />

            {role.lead.length > 0 && (
              <div class="experience-evidence">
                <p class="evidence-label">Accomplishments</p>
                <ul class="experience-lead prose">
                  {role.lead.map((b) => (
                    <li set:html={inlineMarkup(b)} />
                  ))}
                </ul>
              </div>
            )}

            {role.detail.length > 0 && (
              <details class="experience-more">
                <summary>
                  <span class="more-open">Full detail</span>
                  <span class="more-close">Hide detail</span>
                </summary>
                <div class="experience-detail">
                  {role.detail.map((group) => (
                    <div class="detail-group">
                      {group.title && <p class="detail-title mono-label">{group.title}</p>}
                      <ul class="prose">
                        {group.bullets.map((b) => (
                          <li set:html={inlineMarkup(b)} />
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </details>
            )}

            {role.tags.length > 0 && (
              <ul class="tag-list" aria-label="Areas of work">
                {role.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .experience-list {
    list-style: none;
  }

  .experience {
    position: relative;
    display: grid;
    grid-template-columns: minmax(170px, 0.34fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 92px);
    padding: 48px 0;
    border-top: 1px solid var(--line);
  }

  .experience:first-child {
    border-top: 3px solid var(--ink);
  }

  .experience:last-child {
    border-bottom: 1px solid var(--line);
  }

  .experience-meta p {
    margin: 0;
  }

  .experience-meta .company {
    margin-bottom: 8px;
    font-family: var(--display);
    font-size: 19px;
    font-weight: 680;
  }

  .experience-meta p:last-child {
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 13px;
  }

  .experience-body h3 {
    margin-bottom: 26px;
    font-family: var(--display);
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 650;
    line-height: 1;
  }

  .evidence-label {
    margin-bottom: 7px;
    color: var(--teal);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .experience-summary {
    max-width: 72ch;
    color: var(--ink-soft);
    font-size: 17px;
  }

  .experience-evidence {
    margin-top: 28px;
  }

  .experience-lead {
    list-style: none;
    max-width: 76ch;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .experience-lead li {
    position: relative;
    padding: 13px 12px 13px 28px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 15px;
  }

  .experience-lead li::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 1.35em;
    width: 9px;
    height: 9px;
    border: 2px solid var(--coral);
    border-radius: 50%;
  }

  .experience-more {
    margin-top: 16px;
  }

  .experience-more summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--teal-dark);
    cursor: pointer;
    list-style: none;
  }

  .experience-more summary::-webkit-details-marker {
    display: none;
  }

  .experience-more summary::after {
    content: '+';
    font-size: 14px;
  }

  .experience-more[open] summary::after {
    content: '–';
  }

  .more-close {
    display: none;
  }

  .experience-more[open] .more-open {
    display: none;
  }

  .experience-more[open] .more-close {
    display: inline;
  }

  .experience-detail {
    display: grid;
    gap: 18px;
    margin-top: 16px;
    max-width: 66ch;
  }

  .detail-title {
    margin-bottom: 6px;
    color: var(--coral);
  }

  .experience-detail ul {
    list-style: none;
    display: grid;
    gap: 7px;
  }

  .experience-detail li {
    position: relative;
    padding-left: 18px;
    color: var(--ink-soft);
    font-size: 15px;
  }

  .experience-detail li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 1px;
    background: var(--line);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin-top: 22px;
  }

  .tag-list li {
    position: relative;
    padding: 0 0 0 12px;
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
  }

  .tag-list li::before {
    content: '';
    position: absolute;
    top: 0.5em;
    left: 0;
    width: 5px;
    height: 5px;
    background: var(--blue);
  }

  @media (min-width: 1800px) {
    .experience {
      grid-template-columns: minmax(260px, 0.34fr) minmax(0, 1fr);
      padding: 72px 0;
    }

    .experience-meta .company {
      font-size: 24px;
    }

    .experience-meta p:last-child,
    .evidence-label,
    .experience-more summary,
    .tag-list li {
      font-size: 14px;
    }

    .experience-body h3 {
      font-size: 54px;
    }

    .experience-summary {
      font-size: 20px;
    }

    .experience-lead li,
    .experience-detail li {
      font-size: 18px;
    }
  }

  @media (max-width: 620px) {
    .experience {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 30px 0 34px;
    }

  }
</style>
