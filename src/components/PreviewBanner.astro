---
interface Props {
  flags: string[];
}

const { flags } = Astro.props;
const label = flags.includes('*') ? 'all hidden content' : flags.join(', ');
---

<div class="preview-banner" role="status">
  <strong>Preview</strong> · showing {label} · not the published view
</div>

<style>
  .preview-banner {
    padding: 0.4rem 1rem;
    text-align: center;
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    background: #7c2d12;
    color: #fff;
  }

  .preview-banner strong {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  @media print {
    .preview-banner {
      display: none;
    }
  }
</style>
