---
import Icon from './Icon.astro';
import { escapeHtml } from '../lib/text';
import type { Resume } from '../data/schema';

interface Props {
  profile: Resume['profile'];
  linkedin: string | null;
}

const { profile, linkedin } = Astro.props;

// The headline allows one *word* wrapped in asterisks; render that span with
// the acid underline-swipe. Everything else is escaped literally.
const headlineHtml = escapeHtml(profile.headline).replace(
  /\*([^*]+)\*/,
  '<em class="hero-mark">$1</em>'
);

const deliveryPath = [
  'Frame the problem',
  'Build the system',
  'Prove the signal',
  'Operate at scale',
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy reveal">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> {profile.role} at {profile.company}</p>
    <h1 id="hero-title" set:html={headlineHtml} />
    <p class="hero-intro">{profile.intro}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#work">
        Explore my work <Icon name="arrow-down-right" size={16} />
      </a>
      {
        linkedin && (
          <a class="button button-secondary" href={linkedin} target="_blank" rel="noreferrer">
            Connect on LinkedIn <Icon name="arrow-up-right" size={16} />
          </a>
        )
      }
    </div>
  </div>

  <div class="hero-visual reveal" data-delay="1">
    <div class="portrait-frame">
      <img
        src={profile.avatar}
        alt={`Portrait of ${profile.name}`}
        width="480"
        height="600"
        loading="eager"
        decoding="async"
      />
      <div class="systems-note" aria-hidden="true">
        <span>MODEL EVAL</span>
        <span>DISTRIBUTED RUNTIME</span>
        <span>PRODUCTION SLO</span>
      </div>
    </div>
    <p class="portrait-note"><span>Based in</span> {profile.location}</p>
  </div>

  <div class="delivery-panel">
    <span class="trace-progress" data-trace-line aria-hidden="true"></span>
    <ol class="delivery-path" aria-label="Delivery path">
      {
        deliveryPath.map((stage, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {stage}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(300px, 0.6fr);
    grid-template-areas:
      'copy visual'
      'path path';
    align-items: center;
    gap: clamp(36px, 5vw, 68px);
    width: var(--content);
    min-height: min(720px, calc(100svh - 104px));
    margin: 0 auto;
    padding: clamp(28px, 4vh, 44px) 0 20px;
  }

  .hero-copy {
    grid-area: copy;
    padding-bottom: 12px;
  }

  .hero .eyebrow {
    margin-bottom: 22px;
    color: var(--ink-soft);
  }

  .status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 0 5px rgba(228, 91, 64, 0.14);
  }

  .hero h1 {
    max-width: 14ch;
    font-family: var(--display);
    font-size: clamp(48px, 5.2vw, 78px);
    font-weight: 680;
    line-height: 0.9;
  }

  .hero h1 :global(.hero-mark) {
    position: relative;
    font-style: normal;
    color: var(--teal-dark);
  }

  .hero h1 :global(.hero-mark)::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    z-index: -1;
    height: 4px;
    background: var(--coral);
  }

  .hero-intro {
    max-width: 62ch;
    margin-top: 20px;
    color: var(--ink-soft);
    font-size: clamp(16px, 1.4vw, 19px);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--ink);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .button-primary {
    background: var(--ink);
    color: var(--paper-bright);
  }

  .button-primary:hover {
    background: var(--teal-dark);
    transform: translateY(-3px);
  }

  .button-secondary:hover {
    transform: translateY(-3px);
  }

  .hero-visual {
    grid-area: visual;
    position: relative;
    align-self: center;
    width: min(100%, 350px);
    justify-self: end;
  }

  .portrait-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-left: 6px solid var(--teal);
    background: var(--fog);
    overflow: hidden;
  }

  .portrait-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 58%, rgba(16, 23, 21, 0.22));
    pointer-events: none;
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    filter: saturate(0.85) contrast(1.02);
  }

  .portrait-note {
    margin-top: 20px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .portrait-note span {
    color: var(--ink-soft);
    margin-right: 6px;
  }

  .systems-note {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    display: grid;
    gap: 2px;
    grid-template-columns: repeat(3, 1fr);
    padding: 12px 14px;
    background: color-mix(in srgb, var(--ink) 90%, transparent);
    color: #fff;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .delivery-panel {
    grid-area: path;
    position: relative;
  }

  .trace-progress {
    position: absolute;
    top: -1px;
    right: 0;
    left: 0;
    z-index: 1;
    height: 2px;
    background: linear-gradient(90deg, var(--teal), var(--blue), var(--coral));
    transform-origin: left;
    animation: trace-draw 1.1s 0.18s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes trace-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .delivery-path {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    width: 100%;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 550;
    text-transform: uppercase;
  }

  .delivery-path li {
    position: relative;
    display: grid;
    gap: 5px;
    padding: 14px 16px 14px 0;
  }

  .delivery-path li:not(:last-child) {
    border-right: 1px solid var(--line);
  }

  .delivery-path li:not(:first-child) {
    padding-left: 16px;
  }

  .delivery-path span {
    color: var(--teal);
    font-size: 12px;
  }

  @media (min-width: 1800px) {
    .hero {
      grid-template-columns: minmax(0, 1.35fr) minmax(440px, 0.65fr);
      gap: clamp(80px, 6vw, 160px);
      min-height: min(1040px, calc(100svh - 112px));
      padding: clamp(52px, 5vh, 84px) 0 36px;
    }

    .hero .eyebrow {
      margin-bottom: 30px;
      font-size: 14px;
    }

    .hero h1 {
      max-width: 15ch;
      font-size: clamp(96px, 3vw, 116px);
    }

    .hero-intro {
      max-width: 66ch;
      margin-top: 30px;
      font-size: 22px;
    }

    .hero-actions {
      margin-top: 34px;
    }

    .button {
      min-height: 52px;
      padding: 0 24px;
      font-size: 17px;
    }

    .hero-visual {
      width: min(100%, 520px);
    }

    .portrait-note {
      font-size: 14px;
    }

    .systems-note {
      padding: 16px 18px;
      font-size: 14px;
    }

    .delivery-path {
      font-size: 14px;
    }

    .delivery-path li {
      gap: 8px;
      padding: 20px 24px 20px 0;
    }

    .delivery-path li:not(:first-child) {
      padding-left: 24px;
    }

    .delivery-path span {
      font-size: 12px;
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-areas: 'copy' 'visual' 'path';
      min-height: auto;
      max-height: none;
      padding-top: 56px;
    }

    .hero-visual {
      display: grid;
      grid-template-columns: minmax(0, 420px);
      justify-content: start;
      width: 100%;
      justify-self: start;
    }

    .delivery-path {
      grid-template-columns: repeat(2, 1fr);
    }

    .delivery-path li:nth-child(2) {
      border-right: 0;
    }

    .delivery-path li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 620px) {
    .hero {
      gap: 40px;
    }

    .hero h1 {
      font-size: clamp(42px, 13vw, 58px);
    }

    .hero-actions,
    .hero-actions .button {
      width: 100%;
    }

    .systems-note {
      grid-template-columns: 1fr;
      font-size: 12px;
    }
  }
</style>
