---
// Inline SVG. Replaces the Lucide CDN bundle the reference site loaded from
// unpkg to draw a handful of glyphs.
// prettier-ignore
type IconName = 'github' | 'linkedin' | 'mail' | 'file' | 'link' | 'menu' | 'arrow-up-right' | 'arrow-down-right' | 'arrow-up' | 'download';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;

const brand = name === 'github' || name === 'linkedin';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={brand ? 'currentColor' : 'none'}
  stroke={brand ? 'none' : 'currentColor'}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'github' && (
      <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
    )
  }
  {
    name === 'linkedin' && (
      <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z" />
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="2" y="4.5" width="20" height="15" rx="2.5" />
        <path d="m3 7 8.16 5.44a1.5 1.5 0 0 0 1.68 0L21 7" />
      </>
    )
  }
  {
    name === 'file' && (
      <>
        <path d="M14 2.5H7A2 2 0 0 0 5 4.5v15a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-12Z" />
        <path d="M14 2.5v5a1 1 0 0 0 1 1h4" />
        <path d="M9 13h6M9 17h4" />
      </>
    )
  }
  {
    name === 'link' && (
      <>
        <path d="M10 13a4 4 0 0 0 5.66 0l3-3A4 4 0 0 0 13 4.34l-1.5 1.5" />
        <path d="M14 11a4 4 0 0 0-5.66 0l-3 3A4 4 0 0 0 11 19.66l1.5-1.5" />
      </>
    )
  }
  {
    name === 'menu' && <path d="M3 6h18M3 12h18M3 18h18" />
  }
  {
    name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />
  }
  {
    name === 'arrow-down-right' && <path d="M7 7l10 10M17 8v9H8" />
  }
  {
    name === 'arrow-up' && <path d="M12 19V5M6 11l6-6 6 6" />
  }
  {
    name === 'download' && (
      <>
        <path d="M12 3v12M7 10l5 5 5-5" />
        <path d="M5 21h14" />
      </>
    )
  }
</svg>
