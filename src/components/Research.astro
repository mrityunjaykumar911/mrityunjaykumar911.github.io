---
import Icon from './Icon.astro';
import { inlineMarkup } from '../lib/text';
import type { Research } from '../data/schema';

interface Props {
  id: string;
  research: Research;
}

const { id, research } = Astro.props;
const { feature, notes } = research;
---

<section class="section research-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-heading light reveal">
    <p class="section-number">03</p>
    <div>
      <p class="eyebrow">Research &amp; systems</p>
      <h2 id={`${id}-title`}>Ideas tested in code.</h2>
    </div>
    <p class="section-lede">
      My academic work sharpened the same questions I bring to production: where
      contention appears, what failure means, and how correctness is verified.
    </p>
  </div>

  <div class="research-grid">
    <article class="feature-story reveal">
      <p class="story-label mono-label">{feature.label}</p>
      <h3>{feature.title}</h3>
      <p class="prose" set:html={inlineMarkup(feature.body)} />
      {
        feature.link && (
          <a href={feature.link.href} target="_blank" rel="noreferrer">
            {feature.link.text} <Icon name="arrow-up-right" size={15} />
          </a>
        )
      }
    </article>

    <ol class="research-notes">
      {
        notes.map((note) => (
          <li class="research-note reveal">
            <p class="note-type mono-label">{note.type}</p>
            <h3>{note.title}</h3>
            <p class="note-meta">{note.meta}</p>
            {note.href && (
              <a href={note.href} target="_blank" rel="noreferrer" aria-label={`Open: ${note.title}`}>
                <Icon name="arrow-up-right" size={15} />
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .research-section {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper-bright);
  }

  .research-section::after {
    content: '';
    position: absolute;
    top: -100px;
    right: -80px;
    width: 320px;
    height: 320px;
    border: 1px solid rgba(213, 239, 114, 0.22);
    border-radius: 50%;
    box-shadow: 0 0 0 42px rgba(213, 239, 114, 0.035),
      0 0 0 84px rgba(213, 239, 114, 0.025);
  }

  .research-section .section-heading h2 {
    color: var(--paper-bright);
  }

  .section-heading.light .eyebrow {
    color: #aeb9b4;
  }

  .section-heading.light .section-lede {
    color: #aeb9b4;
  }

  .research-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
    gap: clamp(44px, 8vw, 110px);
  }

  .feature-story {
    padding: 40px;
    border-left: 6px solid var(--acid);
    background: var(--teal-dark);
  }

  .feature-story .story-label {
    color: var(--acid);
    margin-bottom: 18px;
  }

  .feature-story h3 {
    font-family: var(--serif);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 500;
    line-height: 1.08;
    margin-bottom: 14px;
  }

  .feature-story p:not(.story-label) {
    color: #c3cfca;
  }

  .feature-story a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 22px;
    color: var(--paper-bright);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--acid);
    text-underline-offset: 5px;
  }

  .research-notes {
    list-style: none;
    border-top: 1px solid #53605b;
  }

  .research-note {
    position: relative;
    padding: 26px 52px 26px 0;
    border-bottom: 1px solid #53605b;
  }

  .research-note .note-type {
    margin-bottom: 8px;
    color: var(--coral);
  }

  .research-note h3 {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.18;
    margin-bottom: 6px;
  }

  .note-meta {
    margin: 0;
    color: #9ca9a4;
    font-size: 13px;
  }

  .research-note a {
    position: absolute;
    top: 28px;
    right: 0;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid #53605b;
  }

  .research-note a:hover {
    background: var(--acid);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .research-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .feature-story {
      padding: 30px 24px;
    }
  }
</style>
