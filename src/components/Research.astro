---
import Icon from './Icon.astro';
import { inlineMarkup } from '../lib/text';
import { withBase } from '../lib/url';
import type { Research } from '../data/schema';

interface Props {
  id: string;
  research: Research;
  featuredHref?: string | null;
}

const { id, research, featuredHref } = Astro.props;
const { feature } = research;
const notes = featuredHref
  ? [
      { type: 'Engineering notes', title: 'What does a passing check actually establish?', meta: 'Three studies on layout, publication disclosure, and the limits of formal feedback.', href: withBase('/method.html#case-studies') },
      ...research.notes.filter((note) => note.href && note.href !== featuredHref),
    ]
  : research.notes;
---

<section class="research-section" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>Research &amp; writing</h2>

  <div class:list={['research-grid', { 'is-index': featuredHref }]}>
    {!featuredHref && (
    <article class="feature-story">
      <p class="story-label">{feature.label}</p>
      <h3>{feature.title}</h3>
      <p class="prose" set:html={inlineMarkup(feature.body)} />
      {
        feature.link && (
          <a href={feature.link.href}>
            {feature.link.text} <Icon name="arrow-up-right" size={15} />
          </a>
        )
      }
    </article>
    )}

    <ol class="research-notes" aria-label="Research and writing index">
      {
        notes.map((note) => (
          <li class="research-note">
            <p class="note-type">{note.type === 'Design study' ? 'Proposed architecture' : note.type}</p>
            <h3>{note.href ? <a href={note.href}>{note.title}</a> : note.title}</h3>
            <p class="note-meta">{note.meta}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .research-section {
    width: var(--content);
    margin: 0 auto;
    padding: 48px 0 56px;
    border-top: 1px solid var(--line-strong);
  }

  .research-section > h2 {
    margin-bottom: 28px;
    font: 580 30px/1.2 var(--display);
  }

  .research-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--grid-gap);
    align-items: start;
  }

  /* On the homepage, Rolis leads Selected engineering work, so this section is the index alone. */
  .research-grid.is-index {
    grid-template-columns: minmax(0, 1fr);
  }

  .research-grid.is-index .research-notes {
    max-width: 760px;
  }

  .story-label,
  .note-type {
    color: var(--ink-soft);
    font: 500 15px/1.45 var(--sans);
  }

  .feature-story h3 {
    margin: 10px 0 12px;
    font: 560 26px/1.22 var(--display);
  }

  .feature-story .prose {
    color: var(--ink);
    font-size: 18px;
    line-height: 1.6;
  }

  .feature-story a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    margin-top: 8px;
    color: var(--accent-strong);
    text-underline-offset: 4px;
  }

  .research-notes {
    list-style: none;
  }

  .research-note {
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }

  .research-note:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .research-note h3 {
    margin: 4px 0 4px;
    font: 560 20px/1.3 var(--display);
  }

  .research-note a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .research-note a:hover {
    color: var(--accent-strong);
    text-decoration-color: currentColor;
  }

  .note-meta {
    color: var(--ink-soft);
    font-size: 16px;
  }

  @media (max-width: 900px) {
    .research-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
