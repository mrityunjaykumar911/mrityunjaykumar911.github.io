---
import Icon from './Icon.astro';
import { inlineMarkup } from '../lib/text';
import type { Research } from '../data/schema';

interface Props {
  id: string;
  research: Research;
}

const { id, research } = Astro.props;
const { feature, notes } = research;
---

<section class="section research-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-heading light reveal">
    <p class="section-number">03</p>
    <div>
      <p class="eyebrow">Research &amp; systems</p>
      <h2 id={`${id}-title`}>Ideas tested in code.</h2>
    </div>
    <p class="section-lede">
      My academic work sharpened the same questions I bring to production: where
      contention appears, what failure means, and how correctness is verified.
    </p>
  </div>

  <div class="research-grid">
    <article class="feature-story reveal">
      <p class="story-label mono-label">{feature.label}</p>
      <h3>{feature.title}</h3>
      <p class="prose" set:html={inlineMarkup(feature.body)} />
      {
        feature.link && (
          <a href={feature.link.href} target="_blank" rel="noreferrer">
            {feature.link.text} <Icon name="arrow-up-right" size={15} />
          </a>
        )
      }
    </article>

    <ol class="research-notes" aria-label="Research proof registry">
      {
        notes.map((note, index) => (
          <li class="research-note reveal">
            <span class="proof-index" aria-hidden="true">P-{String(index + 1).padStart(2, '0')}</span>
            <p class="note-type mono-label">{note.type}</p>
            <h3>{note.title}</h3>
            <p class="note-meta">{note.meta}</p>
            {note.href && (
              <a href={note.href} target="_blank" rel="noreferrer" aria-label={`Open: ${note.title}`}>
                <Icon name="arrow-up-right" size={15} />
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .research-section {
    position: relative;
    overflow: hidden;
    background: #102420;
    color: var(--paper-bright);
  }

  .research-section::before {
    content: 'VERIFIED SYSTEMS / PUBLIC RECORD';
    position: absolute;
    top: 32px;
    right: var(--gutter);
    color: rgba(255, 255, 255, 0.36);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .research-section .section-heading h2 {
    color: var(--paper-bright);
  }

  .section-heading.light .eyebrow {
    color: #aeb9b4;
  }

  .section-heading.light .section-lede {
    color: #aeb9b4;
  }

  .research-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(380px, 1.1fr);
    gap: clamp(44px, 7vw, 96px);
  }

  .feature-story {
    align-self: start;
    padding: 30px 0 0;
    border-top: 6px solid var(--acid);
  }

  .feature-story .story-label {
    color: var(--acid);
    margin-bottom: 18px;
  }

  .feature-story h3 {
    font-family: var(--display);
    font-size: clamp(30px, 3.3vw, 46px);
    font-weight: 640;
    line-height: 1;
    margin-bottom: 14px;
  }

  .feature-story p:not(.story-label) {
    color: #c3cfca;
  }

  .feature-story a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 22px;
    color: var(--paper-bright);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--acid);
    text-underline-offset: 5px;
  }

  .research-notes {
    list-style: none;
    border-top: 1px solid #53605b;
  }

  .research-note {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr 42px;
    column-gap: 14px;
    padding: 20px 0;
    border-bottom: 1px solid #53605b;
  }

  .research-note .note-type {
    grid-column: 2;
    margin-bottom: 8px;
    color: var(--coral);
  }

  .research-note h3 {
    grid-column: 2;
    font-family: var(--display);
    font-size: 20px;
    font-weight: 620;
    line-height: 1.18;
    margin-bottom: 6px;
  }

  .note-meta {
    grid-column: 2;
    margin: 0;
    color: #9ca9a4;
    font-size: 13px;
  }

  .research-note a {
    grid-column: 3;
    grid-row: 1 / span 3;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid #53605b;
  }

  .proof-index {
    grid-column: 1;
    grid-row: 1 / span 3;
    color: var(--acid);
    font-family: var(--mono);
    font-size: 12px;
  }

  .research-note a:hover {
    background: var(--acid);
    color: var(--ink);
  }

  @media (min-width: 1800px) {
    .research-section::before,
    .proof-index {
      font-size: 14px;
    }

    .feature-story h3 {
      font-size: 56px;
    }

    .feature-story p:not(.story-label) {
      font-size: 20px;
    }

    .research-note h3 {
      font-size: 24px;
    }

    .note-meta {
      font-size: 16px;
    }
  }

  @media (max-width: 900px) {
    .research-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .feature-story {
      padding: 30px 24px;
    }
  }
</style>
