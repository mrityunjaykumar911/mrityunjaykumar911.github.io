---
import Icon from './Icon.astro';
import { inlineMarkup } from '../lib/text';
import type { Research } from '../data/schema';

interface Props {
  id: string;
  research: Research;
}

const { id, research } = Astro.props;
const { feature, notes } = research;
---

<section class="section research-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-heading light reveal">
    <p class="eyebrow">Research &amp; systems</p>
    <div class="heading-body">
      <h2 id={`${id}-title`}>Ideas tested in code.</h2>
      <p class="section-lede">
        My academic work sharpened the same questions I bring to production: where
        contention appears, what failure means, and how correctness is verified.
      </p>
    </div>
  </div>

  <div class="research-grid">
    <article class="feature-story reveal">
      <p class="story-label mono-label">{feature.label}</p>
      <h3>{feature.title}</h3>
      <p class="prose" set:html={inlineMarkup(feature.body)} />
      {
        feature.link && (
          <a href={feature.link.href} target="_blank" rel="noreferrer">
            {feature.link.text} <Icon name="arrow-up-right" size={15} />
          </a>
        )
      }
    </article>

    <ol class="research-notes" aria-label="Research proof registry">
      {
        notes.map((note, index) => (
          <li class="research-note reveal">
            <span class="proof-index" aria-hidden="true">P-{String(index + 1).padStart(2, '0')}</span>
            <p class="note-type mono-label">{note.type}</p>
            <h3>{note.title}</h3>
            <p class="note-meta">{note.meta}</p>
            {note.href && (
              <a href={note.href} target="_blank" rel="noreferrer" aria-label={`Open: ${note.title}`}>
                <Icon name="arrow-up-right" size={15} />
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .research-section {
    position: relative;
    overflow: hidden;
    background: var(--ink-deep);
    color: #fff;
  }

  .research-section::before {
    content: none;
  }

  .research-section .section-heading h2 {
    color: #fff;
  }

  .section-heading.light .eyebrow {
    color: var(--accent-on-dark);
  }

  .section-heading.light .section-lede {
    color: rgba(255, 255, 255, 0.68);
  }

  .research-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1.15fr);
    gap: var(--grid-gap);
  }

  .feature-story {
    position: sticky;
    top: 92px;
    align-self: start;
    padding: 28px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .feature-story .story-label {
    color: var(--accent-on-dark);
    margin-bottom: 18px;
  }

  .feature-story h3 {
    font-family: var(--display);
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 640;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .feature-story p:not(.story-label) {
    color: rgba(255, 255, 255, 0.72);
  }

  .feature-story a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 22px;
    color: #fff;
    font-weight: 560;
    text-decoration: underline;
    text-decoration-color: var(--accent-on-dark);
    text-underline-offset: 5px;
  }

  .research-notes {
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .research-note {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr 42px;
    column-gap: 14px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .research-note .note-type {
    grid-column: 2;
    margin-bottom: 8px;
    color: var(--accent-on-dark);
  }

  .research-note h3 {
    grid-column: 2;
    font-family: var(--display);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }

  .note-meta {
    grid-column: 2;
    margin: 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
  }

  .research-note a {
    grid-column: 3;
    grid-row: 1 / span 3;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }

  .proof-index {
    grid-column: 1;
    grid-row: 1 / span 3;
    color: rgba(255, 255, 255, 0.38);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
  }

  .research-note a:hover {
    background: #fff;
    color: var(--ink);
    border-color: #fff;
  }

  @media (min-width: 1800px) {
    .research-section::before,
    .proof-index {
      font-size: 14px;
    }

    .feature-story h3 {
      font-size: 56px;
    }

    .feature-story p:not(.story-label) {
      font-size: 20px;
    }

    .research-note h3 {
      font-size: 24px;
    }

    .note-meta {
      font-size: 16px;
    }
  }

  @media (max-width: 900px) {
    .research-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .feature-story {
      padding: 30px 0 0;
    }
  }
</style>
