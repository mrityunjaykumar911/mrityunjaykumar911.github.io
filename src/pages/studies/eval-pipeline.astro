---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { withBase } from '../../lib/url';
import { Content as DesignDoc } from '../../data/studies/eval-pipeline.md';
import designDocSource from '../../data/studies/eval-pipeline.md?raw';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/source-sans-3';

// The design doc is the single source of truth for the diagrams. They are
// pulled out here and rendered natively by Mermaid in the browser. In the
// appendix, the remark plugin in astro.config.mjs swaps each block for a link
// back to its figure so nothing renders twice.
const mermaidSources = [...designDocSource.matchAll(/```mermaid\n([\s\S]*?)```/g)].map((m) => m[1].trim());
if (mermaidSources.length !== 4) {
  throw new Error(`Expected 4 mermaid diagrams in the eval design doc, found ${mermaidSources.length}`);
}
const [architectureDiagram, endToEndDiagram, lifecycleDiagram, outboxDiagram] = mermaidSources;

// Baseline (v0): one eval pipeline over one metadata table. ER column types
// are illustrative; Mermaid requires one per column.
const sketchArchitecture = `flowchart LR
    MATH((Math500)) --> ING[Ingestion Pipeline]
    ING -.-> BLOB[(Blob Storage)]
    ING --> EVAL
    subgraph EVAL[Eval Pipeline]
        direction LR
        GEN[LLMGeneration Pipeline] ~~~ GRADE[Grading Pipeline]
    end
    EVAL --> LLM[LLM API]
    EVAL --> META[(Metadata Table)]`;

const sketchSchema = `erDiagram
    direction LR
    JOB ||--o{ EVAL_ROW : "has rows"
    EVAL_ROW ||--o| GRADER_OUTPUT : "graded into"
    JOB {
        uuid JobUUID PK
        string DatasetUri
        enum JobState
    }
    EVAL_ROW {
        uuid JobUUID PK, FK
        int RowID PK
        enum EvalState
        text InputQuestion
        text RefOutput
        text LLMOutput
        string GraderIID
        json ModelParameterJson
    }
    GRADER_OUTPUT {
        uuid JobUUID PK, FK
        int RowID PK, FK
        json GraderOutput
    }`;

// What one evaluation is: binary verdicts, pinned at a point in time.
const evalIdentityDiagram = `flowchart LR
    subgraph PIN["Pinned when the run is created"]
        direction TB
        DS[("Dataset snapshot<br/>content_hash")]
        MC["Model config<br/>+ model_version"]
        GR["grader_uuid<br/>→ grader_version"]
    end
    DS --> GEN["Generate answer<br/>per question"]
    MC --> GEN
    GEN --> ANS[("Stored answers<br/>generation_id")]
    ANS --> GRD["Grade<br/>verdict = 0 or 1"]
    GR --> GRD
    GRD --> REP["Report at time t<br/>accuracy = Σ verdicts / graded<br/>coverage = graded / total"]
    NG["New grader_version"] -.-> RG["Re-grade<br/>no LLM calls"]
    ANS -.-> RG
    RG -.-> REP2["New report at t′<br/>same answers"]`;

// Scaled (v1) records in ExecutionService.
const dataModelDiagram = `erDiagram
    direction LR
    EXECUTION ||--|{ TASK : "one per record"
    TASK ||--|{ GENERATION_ATTEMPT : "retries add attempts"
    GENERATION_ATTEMPT ||--o{ GRADING_RESULT : "one per grader version"
    EXECUTION {
        string execution_id PK
        string dataset_content_hash
        json model_config
        string model_version
        string grader_uuid
        string grader_version
    }
    TASK {
        string execution_id PK, FK
        string record_id PK
        string state
    }
    GENERATION_ATTEMPT {
        string generation_id PK
        string execution_id FK
        string record_id FK
        text answer
    }
    GRADING_RESULT {
        string generation_id PK, FK
        string grader_version PK
        string grader_config_hash PK
        int verdict "0 or 1"
    }`;

// Scale-out data plane for ExecutionService.
const scalePlaneDiagram = `flowchart TB
    C[Client] -->|"POST /v1/executions"| API[Execution API]
    API -->|"admit, or 429 / 503"| Q[("Execution queue<br/>task = (execution_id, record_id)")]
    Q --> W1 & W2 & WN
    subgraph WORKERS["Execution workers × N: stateless, competing consumers"]
        direction LR
        W1["Worker 1<br/>generate → grade"]
        W2["Worker 2<br/>generate → grade"]
        WN["Worker N<br/>generate → grade"]
    end
    SIG(["Signals: queue depth, oldest age,<br/>latency, CPU, provider budget"]) -.-> AS[Autoscaler]
    AS -.->|"scale N"| WORKERS
    W1 & W2 & WN --> LIM{{"Distributed limiter<br/>global · per model · per tenant"}}
    LIM --> LLM[External LLM API]
    W1 & W2 & WN --> DB[("Results DB + outbox")]
    DB -->|"task events"| AGG[AggregationService]`;

// Temporal mini workers: one small pool per task queue.
const temporalPoolsDiagram = `flowchart TB
    API[Execution API] -->|"start EvaluationWorkflow<br/>workflow id = execution_id"| T[("Temporal cluster<br/>durable event history")]
    subgraph POOLS["Temporal mini workers: one pool per task queue"]
        direction LR
        WF["Workflow workers<br/>orchestration only, no I/O"]
        GEN["Generate workers<br/>async I/O, many calls in flight"]
        GRD["Grade workers<br/>CPU-bound, sandboxed"]
        PUB["Publish workers<br/>events to AggregationService"]
    end
    T <-->|"tq: workflows"| WF
    T <-->|"tq: generate-model<br/>rate limit = provider limit"| GEN
    T <-->|"tq: grade"| GRD
    T <-->|"tq: publish"| PUB
    GEN --> LLM[External LLM API]
    GEN --> DB[("Results DB")]
    GRD --> DB
    PUB -->|"POST event with event_id"| AGG[AggregationService]`;

const temporalFlowDiagram = `sequenceDiagram
    participant API as Execution API
    participant P as Evaluation workflow (parent)
    participant B as BatchWorkflow (child)
    participant G as generate activity
    participant R as grade activity
    participant E as publish activity
    API->>P: start, workflow id = execution_id
    P->>B: one child per batch of at most 500 questions
    loop each question, up to max_concurrency at once
        B->>G: generate(record_id), retry policy A
        G-->>B: generation_id
        B->>R: grade(generation_id, grader_version), retry policy B
        R-->>B: verdict 0 or 1
        B->>E: publish TASK_GRADED(event_id)
    end
    B-->>P: batch complete
    Note over API,P: cancel = workflow cancellation, progress = query`;

const temporalReasons = [
  {
    title: 'Durable task state without a state table',
    body: 'The task lifecycle lives in the workflow event history. If a worker dies, another one replays the history and continues from the last completed step. Generate and grade are separate activities, and a completed result is recorded, so a grading retry never re-runs generation.',
    replaces: 'Task-state table and conditional transitions',
  },
  {
    title: 'Retries are declared, not hand-coded',
    body: 'Each activity gets its own retry policy: backoff, maximum attempts, and non-retryable errors such as invalid requests or bad credentials. Generation and grading retry on different terms.',
    replaces: 'Retry-wait states and backoff code',
  },
  {
    title: 'Dead workers are detected by timeouts',
    body: 'Start-to-close and heartbeat timeouts tell Temporal when a long model call or grading run has stalled, and the activity is retried elsewhere.',
    replaces: 'Queue lease renewal for long-running work',
  },
  {
    title: 'The provider limit is enforced by the server',
    body: "One generate task queue per model, with max_task_queue_activities_per_second set to the provider's rate. Temporal enforces it across every worker on that queue, so adding generate workers cannot exceed it. Concurrency is still capped per worker, so pool size × max_concurrent_activities must stay under the provider's concurrency.",
    replaces: 'Hand-built distributed rate limiter',
  },
  {
    title: 'Each pool scales on its own bottleneck',
    body: 'Generate workers are I/O-bound and hold many async calls. Grade workers are CPU-bound and run sandboxed in separate processes. Workflow workers are light. Each pool scales on its own task-queue backlog, so a slow grader never holds model calls hostage.',
    replaces: 'One worker type doing everything',
  },
  {
    title: 'Idempotent create and cancel come built in',
    body: 'The workflow ID is the execution_id. With a conflict policy that returns the running workflow, a retried POST cannot start a second run. Cancel is workflow cancellation, and progress is a query.',
    replaces: 'Execution-side create dedupe, cancel and progress plumbing',
  },
  {
    title: 'The outbox publisher becomes a workflow step',
    body: 'Publish runs only after the result commit completes, and it retries until AggregationService accepts the event. The inbox there still deduplicates by event_id.',
    replaces: 'Outbox table and publisher loop',
  },
];

const temporalLimits = [
  'Event history is capped at 51,200 events or 50 MB per workflow run. At roughly 10 events per question (three activities plus workflow tasks), one workflow for a 10,000-question run would pass the cap. So a parent fans out child workflows of at most 500 questions, about 5,000 events each, or uses Continue-As-New.',
  'Payloads error at 2 MB. Activities pass generation_id, never answer text; answers stay in the Results DB.',
  'Activities are at-least-once. A model call can run again if a worker dies mid-call, so commits stay idempotent and provider idempotency keys still matter. Temporal does not make LLM calls exactly-once.',
  'Workflow code must be deterministic. Model calls and grading happen only inside activities.',
  'It is new infrastructure to run: a Temporal cluster or Temporal Cloud, and at least two workers per task queue for availability.',
];

// Measured on the running system.
const latencyChart = `---
config:
  themeVariables:
    xyChart:
      plotColorPalette: "#087a55"
---
xychart-beta
    title "End-to-end latency per evaluation (minutes)"
    x-axis ["P50", "P95", "P99"]
    y-axis "Minutes" 0 --> 60
    bar [24, 26, 60]`;

const retryStateDiagram = `flowchart TB
    R1["Run 1<br/>pins: snapshot hash, model version, grader version"] -->|"some tasks failed"| R2["Retry run 2<br/>parent = run 1, same pins"]
    R2 --> Q{"For each task:<br/>what is already saved?"}
    Q -->|"verdict exists"| A["Reuse the verdict<br/>0 LLM calls"]
    Q -->|"answer stored, no verdict"| B["Re-grade the stored answer<br/>0 LLM calls"]
    Q -->|"no answer"| C["Generate, then grade"]
    A & B & C --> REP["Report for run 2"]
    REP -.->|"lineage"| L["report → run → task → attempt → verdict"]`;

const observabilityDiagram = `flowchart LR
    subgraph APP["Instrumented with OpenTelemetry"]
        direction TB
        API[Execution API]
        WK["Temporal mini workers<br/>TracingInterceptor"]
        AGG[AggregationService]
    end
    APP -->|"traces, OTLP"| COL[OTel Collector]
    COL --> TR[(Trace store)]
    APP -->|"Temporal SDK and service metrics"| PROM[(Prometheus)]
    PROM --> GRAF["Grafana<br/>dashboards and alerts"]
    TR --> GRAF`;

const issues = [
  {
    title: 'Backed-up queue',
    symptom: 'Tasks wait in the queue before any worker picks them up. The median barely moves while P99 grows.',
    answer: 'Admission control with per-tenant quotas at the API. Each mini worker pool autoscales on schedule-to-start latency and backlog age, not queue depth alone. Child workflows of at most 500 questions keep one large evaluation from holding a whole queue.',
    signal: 'temporal_activity_schedule_to_start_latency per task queue; outstanding evaluations per tenant.',
  },
  {
    title: 'Throttling',
    symptom: 'The provider returns 429s. Retries pile on top of new work and the tail stretches.',
    answer: "One generate task queue per model, with max_task_queue_activities_per_second at the provider's rate, so Temporal holds dispatch under the limit across all workers. Pool size × max_concurrent_activities stays under the provider's concurrency. Retry-After is respected, with exponential backoff and jitter.",
    signal: 'Provider 429 rate, activity retries per minute, tokens per minute against quota.',
  },
  {
    title: 'Retry and lineage tracking',
    symptom: 'After retries, it is hard to tell which attempt produced a verdict, or which run a number came from.',
    answer: 'Every model call is a row with (generation_id, attempt_id). Verdicts are keyed by (generation_id, grader_version, grader_config_hash). Each run stores its pins and its Temporal workflow and run IDs, and a retry run records its parent run. Any number traces back: report, run, task, attempt, verdict.',
    signal: 'Attempts per task, retry runs per evaluation, verdicts without a lineage path (should be zero).',
  },
  {
    title: 'Retry from saved state',
    symptom: 'Re-running a failed evaluation from scratch repeats model calls that already succeeded.',
    answer: "A retry loads the original run's pins, never today's defaults. Tasks with a verdict are reused, tasks with a stored answer are only re-graded, and only tasks with no answer call the model again. In-flight workflows resume from Temporal history; finished runs resume from the Results DB.",
    signal: 'Share of tasks reused per retry run; model calls avoided.',
  },
  {
    title: 'Analytics integration',
    symptom: 'Reports stay inside the service, and comparisons become ad hoc queries over raw tables.',
    answer: 'AggregationService exports deduplicated, task-level verdict events, each carrying its pins, to the analytics store. Comparisons join on the pins, so only like-for-like evaluations are compared.',
    signal: 'Export lag, and exported rows reconciling with graded + failed + cancelled = total.',
  },
  {
    title: 'Telemetry and observability',
    symptom: 'Without one trace per evaluation, a slow P99 run cannot be explained.',
    answer: "OpenTelemetry traces run from the API through the workflow, activities, model call, and grader, propagated by Temporal's TracingInterceptor. Prometheus scrapes Temporal SDK and service metrics. Grafana holds the dashboards and the alerts on P95, P99, throughput, and throttling.",
    signal: 'Latency histogram (P50, P95, P99), evaluations per hour, schedule-to-start latency, 429 rate.',
  },
];

const claims = [
  {
    claim: 'Generation throughput grows linearly with workers until the provider limit.',
    mechanism: 'Per-question tasks on a shared queue. Workers are stateless and never coordinate with each other.',
    bound: 'X ≤ min(N · c / W, R), for N workers, c calls each, W seconds per call, R provider rate.',
    breaks: 'When R binds. More workers then only add 429s, so the limiter caps concurrency instead.',
  },
  {
    claim: 'Ingestion cost does not grow with the number of evaluations.',
    mechanism: 'Datasets are content-addressed snapshots. Equal content is stored once, and executions read Blob directly.',
    bound: 'One fetch and parse per unique dataset content: O(dataset bytes).',
    breaks: 'Only first-time content pays. Evaluations never touch ingestion.',
  },
  {
    claim: 'Changing the grader costs no LLM calls.',
    mechanism: 'Answers are stored apart from verdicts, and verdicts are keyed by grader version.',
    bound: 'Re-grade cost = questions × grader CPU time.',
    breaks: 'If the grader is itself an LLM judge, it needs its own provider budget and limiter.',
  },
  {
    claim: 'A retry never duplicates a verdict.',
    mechanism: 'Stable task identity, conditional state transitions, idempotent commits, and a deduplicating inbox.',
    bound: 'LLM calls per question ≤ 1 + the generation retry limit. Grading retries add zero.',
    breaks: 'A timed-out call may still be billed by the provider. That costs money, not correctness.',
  },
  {
    claim: 'Aggregation cost per event is constant and independent of model latency.',
    mechanism: 'Insert into the inbox by event_id, then update counters.',
    bound: 'O(1) work per event and O(tasks) inbox rows per evaluation.',
    breaks: 'One very large evaluation turns its counter row into a write hotspot. Mitigation: shard counters by task hash and sum on read.',
  },
  {
    claim: 'A burst becomes waiting time, not errors, up to the admission limit.',
    mechanism: 'Durable per-service queues plus admission control.',
    bound: 'Backlog grows at λ − μ while arrivals exceed capacity. Outstanding work is capped per tenant.',
    breaks: 'Sustained λ > μ. Then the answer is more safe capacity or 429/503, not a deeper queue.',
  },
  {
    claim: 'Orchestration state stays bounded per workflow, however large the run.',
    mechanism: 'A parent workflow fans out child workflows of at most 500 questions each.',
    bound: 'About 10 history events per question, so about 5,000 per child: roughly 10% of the 51,200-event cap.',
    breaks: 'One workflow for a whole large run: 10,000 questions is about 100,000 events, past the cap.',
  },
  {
    claim: "One tenant's large run cannot starve other tenants.",
    mechanism: 'Per-tenant quotas, per-tenant concurrency limits, and fair scheduling.',
    bound: "Each tenant's in-flight work ≤ its quota.",
    breaks: 'If quotas add up to more than the provider limit, fairness still holds, but every tenant slows down.',
  },
];

const sketchApis = [
  { call: 'Ingestion · POST', req: 'Headers {effort, ctx_len}; body data: binary', res: 'IID' },
  { call: 'Eval · POST', req: 'ArtifactLink, GraderIID, ttl', res: 'Job_UUID' },
  { call: 'Eval · POST /Requeue', req: 'Job_UUID_1', res: 'Job_UUID_1 (same ID)' },
  { call: 'Eval · GET /status', req: 'Job_UUID', res: 'Job status' },
];

const evolution = [
  {
    sketch: 'effort and ctx_len headers on the ingestion request',
    final: 'No model settings in ingestion. model_config travels with the execution request.',
    why: 'A dataset is reusable across many models and graders.',
  },
  {
    sketch: 'Upload data: binary, get back an IID',
    final: 'Submit a dataset URL, get an ingestion_id, then a READY reference with dataset_id and content hash.',
    why: 'A content-addressed snapshot makes every run reproducible, even if the URL later serves different bytes.',
  },
  {
    sketch: 'ArtifactLink and GraderIID in the eval request',
    final: 'A validated dataset reference and a grader_uuid resolved through a platform registry to a pinned version.',
    why: 'Callers never make workers fetch arbitrary URIs or run arbitrary code.',
  },
  {
    sketch: 'POST returns Job_UUID',
    final: 'POST returns execution_id, with an Idempotency-Key header.',
    why: 'A retried create returns the same execution instead of starting a second one.',
  },
  {
    sketch: '/Requeue returns the same Job_UUID',
    final: 'POST /executions/{id}/retry under an explicit policy, on stable task identity (execution_id, record_id).',
    why: 'Retry keeps identity, so a duplicate delivery cannot create a duplicate result.',
  },
  {
    sketch: 'ttl on the eval request',
    final: 'Not carried over. Explicit POST /cancel plus admission control.',
    why: 'Stopping work is a cooperative state change, checked between generation and grading.',
  },
  {
    sketch: 'EvalState: NotProcessed, InProgress, Finished',
    final: 'Task lifecycle with ANSWER_PERSISTED, two retry-wait states, and FAILED (Figure 3).',
    why: 'The answer is stored before grading, so a grading retry never calls the LLM again. Failure is a state, not a missing row.',
  },
  {
    sketch: 'JobState: Enqueue, InProcess, Cancelled, Finished',
    final: 'Execution status plus terminal accounting: graded + failed + cancelled = total.',
    why: 'A run can finish with some rows failed. That has to be visible, not hidden inside "Finished".',
  },
  {
    sketch: 'One Metadata Table holding LLMOutput, GraderIID, and ModelParameterJson on every row',
    final: 'Each service owns its database. GenerationAttempt and GradingResult are separate records; model config is stored once per execution.',
    why: 'Model calls are nondeterministic, so attempts are kept separately, and a grading result is keyed by (generation_id, grader_version, config_hash).',
  },
  {
    sketch: 'GET /status read from the same table',
    final: 'A separate AggregationService counting deduplicated task events, with accuracy and coverage reported separately.',
    why: 'Counting from events survives duplicates and out-of-order delivery.',
  },
];

const homeHref = withBase('/');
const methodHref = withBase('/method.html');
const year = new Date().getFullYear();

const chapters = [
  { id: 'problem', label: 'The problem' },
  { id: 'evaluation', label: 'Binary eval' },
  { id: 'baseline', label: 'Baseline v0' },
  { id: 'boundaries', label: 'Boundaries first' },
  { id: 'scale-out', label: 'Scaling out' },
  { id: 'temporal', label: 'Temporal workers' },
  { id: 'claims', label: 'Scalability claims' },
  { id: 'results', label: 'Measured results' },
  { id: 'issues', label: 'Main issues' },
  { id: 'failure', label: 'What breaks at scale' },
  { id: 'metrics', label: 'Honest metrics' },
  { id: 'decisions', label: 'Decision log' },
  { id: 'design-doc', label: 'Full design doc' },
];

const services = [
  {
    name: 'IngestionService',
    role: 'Turns a dataset URL into an immutable snapshot.',
    owns: ['REST API', 'Ingestion queue', 'Ingestion workers', 'Metadata DB'],
    load: 'Bursty, network bound. Scales with fetch and parse throughput.',
  },
  {
    name: 'ExecutionService',
    role: 'Generates an answer per question, then grades it.',
    owns: ['REST API', 'Execution queue', 'Execution workers', 'Results DB + outbox'],
    load: 'The hot path. Bound by LLM provider limits and grader CPU.',
  },
  {
    name: 'AggregationService',
    role: 'Turns task events into progress and a final report.',
    owns: ['REST API', 'Aggregation queue', 'Aggregation workers', 'Inbox + counters DB'],
    load: 'Cheap per event. Scales with event rate, not with model latency.',
  },
];

const externals = [
  { name: 'Dataset source URL', note: 'Untrusted input. Fetched once, behind SSRF checks.' },
  { name: 'Azure Blob Storage', note: 'Managed storage, not a service. Holds content-addressed snapshots.' },
  { name: 'External LLM API', note: 'Called directly by execution workers. The real bottleneck.' },
  { name: 'Python grading library', note: 'Runs inside the worker process. Not a network hop.' },
];

const idempotency = [
  { layer: 'API request', key: '(tenant_id, idempotency_key)', guards: 'A client retrying the same create call.' },
  { layer: 'Dataset content', key: '(tenant, normalized_hash, schema_version)', guards: 'Two ingestions of the same bytes.' },
  { layer: 'Task', key: '(execution_id, record_id)', guards: 'A queue delivering the same task twice.' },
  { layer: 'Grading result', key: '(generation_id, grader_version, config_hash)', guards: 'Re-grading the same stored answer.' },
  { layer: 'Event', key: 'event_id', guards: 'The outbox re-sending an event after a lost ack.' },
];

const decisions = [
  { q: 'Why async APIs?', a: 'Downloads, model calls, and grading take minutes. Return 202 and expose durable status instead of holding connections open.' },
  { q: 'Why snapshot datasets?', a: 'A URL can serve different bytes tomorrow. A content-addressed snapshot makes every evaluation reproducible.' },
  { q: 'Why let execution read Blob directly?', a: 'Large payloads should not be proxied through ingestion. It keeps ingestion off the hot path and lets each side scale alone.' },
  { q: 'Why keep model config out of ingestion?', a: 'A dataset is reusable across models and graders. Ingestion should not know about either.' },
  { q: 'Why a grader UUID, not code?', a: 'The platform owns the mapping from ID to an approved, versioned artifact. Callers never supply executable code.' },
  { q: 'Why an outbox, not a direct call?', a: 'The network can fail after the result is committed. Outbox plus inbox gives retryable delivery with deduplication.' },
  { q: 'Why not promise exactly-once?', a: 'An LLM call can succeed on the provider after my worker times out. I make internal state effectively-once instead.' },
  { q: 'Why Temporal mini workers?', a: 'Durable per-question state, declared retries, timeouts, and a server-enforced provider limit, instead of building each by hand. Each small pool scales on its own bottleneck.' },
  { q: 'Why split accuracy from coverage?', a: 'Failed questions are not wrong answers. Mixing them silently moves the denominator.' },
];
---

<Base
  title="Design Study: Scaling Out an LLM Evaluation Pipeline | Mrityunjay Kumar"
  description="How Mrityunjay Kumar reasoned about service boundaries, scale-out, backpressure, and idempotency in a distributed LLM evaluation pipeline."
  canonicalPath="/studies/eval-pipeline.html"
>
  <header class="study-header" id="top">
    <a class="study-wordmark" href={homeHref} aria-label="Return to portfolio">
      <span class="wordmark-mark">MK</span>
      <span>
        <strong>Mrityunjay Kumar</strong>
        <small>Design study · Scale-out architecture</small>
      </span>
    </a>
    <a class="back-link" href={methodHref}>
      Method <Icon name="arrow-up-right" size={15} />
    </a>
  </header>

  <main id="main" class="study-page">
    <section class="study-hero" aria-labelledby="study-title">
      <p class="eyebrow">Design study · Measured at 1,000 evaluations per hour</p>
      <h1 id="study-title">Scaling out an LLM evaluation pipeline</h1>
      <p class="hero-lede">
        A platform for binary, point-in-time LLM evaluation. Every question gets a stored model
        answer and a 0/1 verdict from a selected, pinned grader. Math500 is the sample dataset.
        The happy path is easy. This study is about scale: what happens when the work spreads
        across many workers, the model provider pushes back, and messages arrive twice.
      </p>
      <dl class="hero-facts">
        <div><dt>Throughput</dt><dd>1,000 evals/hour</dd></div>
        <div><dt>P50 latency</dt><dd>24 min</dd></div>
        <div><dt>P95 latency</dt><dd>26 min</dd></div>
        <div><dt>P99 latency</dt><dd>60 min</dd></div>
        <div><dt>Verdict</dt><dd>Binary, 0/1</dd></div>
      </dl>
    </section>

    <nav class="study-nav" aria-label="Study chapters">
      <ol>
        {chapters.map((chapter, index) => (
          <li>
            <a href={`#${chapter.id}`}>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{chapter.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="problem" class="study-section" aria-labelledby="problem-title">
      <div class="section-intro">
        <p class="eyebrow">01 / The problem</p>
        <h2 id="problem-title">State the goal before drawing boxes.</h2>
      </div>
      <div class="prose">
        <p>
          The platform takes a dataset of questions with reference answers, by URL. Math500 is the
          sample; nothing in the design depends on it. For each question it generates an answer
          with an external LLM, asks the selected grader for a binary verdict, and aggregates the
          verdicts into a report. Every step can take minutes, and a run can hold thousands of
          questions.
        </p>
        <p>
          Three goals come first. A result must be <strong>point-in-time</strong>: pinned to a
          dataset snapshot, a model version, and a grader version, so it means the same thing
          tomorrow. Throughput must <strong>scale out</strong> by adding workers, up to the limit
          that the slowest external dependency allows. And the report must be
          <strong>honest</strong> under failure: retries and duplicates must not change the numbers.
        </p>
      </div>
    </section>

    <section id="evaluation" class="study-section" aria-labelledby="evaluation-title">
      <div class="section-intro">
        <p class="eyebrow">02 / Binary, point-in-time evaluation</p>
        <h2 id="evaluation-title">One evaluation is a 0/1 verdict per question, pinned in time.</h2>
        <p>
          The platform accepts any dataset of questions with reference answers. For each question
          it stores the model's answer, and the selected grader returns a binary verdict: 1 if the
          answer is correct, 0 if it is not.
        </p>
      </div>

      <figure class="diagram fit" id="eval-identity">
        <div class="diagram-scroll"><pre class="mermaid">{evalIdentityDiagram}</pre></div>
        <figcaption><span class="mono-label">Point-in-time evaluation</span> <span>What is pinned, where the 0/1 verdict comes from, and the re-grade path.</span></figcaption>
      </figure>

      <div class="prose">
        <p>
          A result is a measurement at a point in time with respect to the selected grader. Four
          things are pinned when the run is created: the dataset snapshot by content hash, the
          model config and model version, the <code>grader_uuid</code>, and the grader version it
          resolves to. Two reports are comparable only when those pins match. Change any one of
          them and it is a different evaluation.
        </p>
        <p>
          Answers and verdicts are stored separately. A grading result is keyed by
          <code>(generation_id, grader_version, grader_config_hash)</code>, so one stored answer can
          carry verdicts from several graders. Re-grading a finished run with a new grader version
          costs grader CPU and no LLM calls, and it produces a new point-in-time report over the
          same answers.
        </p>
        <p>
          Binary verdicts keep the arithmetic simple and honest:
          <code>accuracy = Σ verdicts / graded</code> and <code>coverage = graded / total</code>. A
          question that failed to generate has no verdict. It lowers coverage, not accuracy.
        </p>
      </div>

      <figure class="diagram fit" id="data-model">
        <div class="diagram-scroll"><pre class="mermaid">{dataModelDiagram}</pre></div>
        <figcaption><span class="mono-label">Scaled data model</span> <span>ExecutionService records. One task per record, retries add attempts, and each attempt can hold one binary verdict per grader version.</span></figcaption>
      </figure>
    </section>

    <section id="baseline" class="study-section tinted" aria-labelledby="baseline-title">
      <div class="section-intro">
        <p class="eyebrow">03 / Baseline v0</p>
        <h2 id="baseline-title">Baseline (v0): one pipeline, one table.</h2>
        <p>
          The simplest design that runs an evaluation end to end puts generation and grading
          inside one eval pipeline over one metadata table. It is the baseline this study scales
          from. Three of its ideas survive into the scaled design: a job ID, per-row state keyed
          by <code>(JobUUID, RowID)</code>, and a requeue that keeps the job's identity. The table
          at the end shows what changes when the work spreads across many workers, and why.
        </p>
      </div>

      <figure class="diagram fit" id="sketch-1">
        <div class="diagram-scroll"><pre class="mermaid">{sketchArchitecture}</pre></div>
        <figcaption><span class="mono-label">Baseline v0 · architecture</span> <span>Generation and grading as two pipelines inside one eval pipeline, sharing one metadata table.</span></figcaption>
      </figure>

      <div class="two-col">
        <div>
          <h3>API boundary (v0)</h3>
          <div class="table-wrap tight">
            <table>
              <thead><tr><th scope="col">Call</th><th scope="col">Request</th><th scope="col">Response</th></tr></thead>
              <tbody>
                {sketchApis.map((api) => (
                  <tr><th scope="row">{api.call}</th><td>{api.req}</td><td><code>{api.res}</code></td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <div>
          <h3>State (v0)</h3>
          <dl class="state-lists">
            <div>
              <dt>JobState <span>per job</span></dt>
              <dd><code>Enqueue</code><code>InProcess</code><code>Cancelled</code><code>Finished</code></dd>
            </div>
            <div>
              <dt>EvalState <span>per row</span></dt>
              <dd><code>NotProcessed</code><code>InProgress</code><code>Finished</code></dd>
            </div>
          </dl>
          <p class="state-note">
            Retry is at the job level: <code>/Requeue</code> takes a <code>Job_UUID</code> and
            returns the same one, so a retry never forks the job's identity.
          </p>
        </div>
      </div>

      <figure class="diagram fit" id="sketch-2">
        <div class="diagram-scroll"><pre class="mermaid">{sketchSchema}</pre></div>
        <figcaption><span class="mono-label">Baseline v0 · schema</span> <span>Rows flow through grading into <code>(JobUUID, RowID, GraderOutput)</code>, where GraderOutput is the 0/1 verdict. Types are illustrative.</span></figcaption>
      </figure>

      <h3 class="evolution-title">From baseline to scaled design</h3>
      <div class="table-wrap">
        <table class="evolution">
          <thead><tr><th scope="col">Baseline (v0)</th><th scope="col">Scaled design (v1)</th><th scope="col">Why</th></tr></thead>
          <tbody>
            {evolution.map((row) => (
              <tr><th scope="row">{row.sketch}</th><td>{row.final}</td><td>{row.why}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="boundaries" class="study-section tinted" aria-labelledby="boundaries-title">
      <div class="section-intro">
        <p class="eyebrow">04 / Boundaries first</p>
        <h2 id="boundaries-title">Three services, each owning its API, queue, workers, and database.</h2>
        <p>
          Scale-out starts with ownership. A service can only scale on its own if nothing else
          reads its database or its queue. Services talk only through APIs.
        </p>
      </div>

      <figure class="diagram fit" id="figure-1">
        <div class="diagram-scroll"><pre class="mermaid">{architectureDiagram}</pre></div>
        <figcaption><span class="mono-label">Figure 1</span> High-level architecture. Numbered edges are the client's calls, in order.</figcaption>
      </figure>

      <figure class="arch" aria-label="Load shape of each service and the external dependencies">
        <ol class="arch-services">
          {services.map((service, index) => (
            <li>
              <p class="mono-label">Step {index + 1}</p>
              <h3>{service.name}</h3>
              <p>{service.role}</p>
              <ul>{service.owns.map((item) => <li>{item}</li>)}</ul>
              <p class="arch-load">{service.load}</p>
            </li>
          ))}
        </ol>
        <div class="arch-external">
          <p class="mono-label">External, not services</p>
          <ul>
            {externals.map((item) => (
              <li><strong>{item.name}</strong><span>{item.note}</span></li>
            ))}
          </ul>
        </div>
        <figcaption>
          The client ingests a dataset, waits for <code>READY</code>, then submits the dataset
          reference with a grader UUID and model config to ExecutionService. Execution events
          reach AggregationService through a retrying outbox. The client reads the report there.
        </figcaption>
      </figure>

      <div class="prose">
        <p>
          The hardest calls were about what is <em>not</em> a service. The LLM API is an external
          provider. Blob Storage is managed infrastructure, not a fourth microservice. The grader
          is a library that runs inside the execution worker, so grading costs CPU, not a network
          round trip. Keeping these out of the service count kept the design small and made the
          real bottleneck obvious.
        </p>
        <p>
          Ingestion also never sees the model config or the grader UUID. A dataset is reusable
          across many models and graders, so those are execution concerns. The client chains the
          two calls itself, as <a href="#figure-2">Figure 2</a> shows end to end.
        </p>
      </div>

      <figure class="diagram" id="figure-2">
        <div class="diagram-scroll"><pre class="mermaid">{endToEndDiagram}</pre></div>
        <figcaption><span class="mono-label">Figure 2</span> End-to-end flow, from dataset URL to final report.</figcaption>
      </figure>
    </section>

    <section id="scale-out" class="study-section" aria-labelledby="scale-out-title">
      <div class="section-intro">
        <p class="eyebrow">05 / Scaling out</p>
        <h2 id="scale-out-title">Find the real bottleneck, then scale against it.</h2>
        <p>
          The three services have very different load shapes. That is the main reason to keep
          them separate: each one scales on its own signal.
        </p>
      </div>

      <ol class="reasoning-chain" aria-label="Scale-out reasoning">
        <li>
          <span>Partition</span>
          <p>The unit of work is one question. Task identity is <code>(execution_id, record_id)</code>, so any worker can pick up any task.</p>
        </li>
        <li>
          <span>Bypass</span>
          <p>Execution workers read dataset chunks straight from Blob. Large bytes never pass through ingestion, so ingestion stays off the hot path.</p>
        </li>
        <li>
          <span>Bottleneck</span>
          <p>Execution is bound by the LLM provider and grader CPU, not by worker count. More workers past that point only create 429s.</p>
        </li>
        <li>
          <span>Limit</span>
          <p>Apply distributed concurrency limits at global, per-model, and per-tenant levels. Respect the provider's <code>Retry-After</code>.</p>
        </li>
        <li>
          <span>Signal</span>
          <p>Autoscale on queue depth, oldest message age, end-to-end latency, CPU, memory, and remaining provider budget together.</p>
        </li>
      </ol>

      <figure class="diagram fit" id="scale-plane">
        <div class="diagram-scroll"><pre class="mermaid">{scalePlaneDiagram}</pre></div>
        <figcaption><span class="mono-label">Scale-out data plane</span> <span>Workers are stateless competing consumers. A shared limiter, not the worker count, sets the rate at the provider.</span></figcaption>
      </figure>

      <div class="math-band">
        <article>
          <p class="mono-label">A queue is not capacity</p>
          <h3>1,000 in, 200 out, per minute.</h3>
          <p>
            Backlog grows by 800 tasks every minute. After five minutes, about 4,000 tasks are
            waiting, and it never recovers. A queue absorbs bursts. It does not fix sustained
            overload. Only admission control or more <em>safe</em> capacity does.
          </p>
        </article>
        <article>
          <p class="mono-label">Little's Law</p>
          <h3>L = λ × W</h3>
          <p>
            At 100 tasks per second and 5 seconds in the system, about 500 tasks are in flight.
            That sizes the concurrency I need to hold. It says nothing about what the provider
            will actually allow, so I check both numbers.
          </p>
        </article>
      </div>

      <div class="two-col">
        <div>
          <h3>Admission control</h3>
          <ul class="tick-list">
            <li>Cap outstanding jobs globally, per tenant, and per evaluation, by count and by estimated cost.</li>
            <li>Return <code>429</code> for a tenant quota. Return <code>503</code> with <code>Retry-After</code> for service-wide overload.</li>
            <li>Never return <code>202</code> until the job and its enqueue intent are durable.</li>
            <li>Use fair scheduling so one large evaluation cannot starve small tenants.</li>
          </ul>
        </div>
        <div>
          <h3>Queue choice</h3>
          <p>
            This is task distribution, not stream processing. A Service Bus or SQS style queue
            gives me leases, delayed retries, dead-letter queues, and competing consumers out of
            the box. Kafka earns its cost when ordered replay and high-throughput streams are core
            requirements. Here they are not.
          </p>
        </div>
      </div>
    </section>

    <section id="temporal" class="study-section" aria-labelledby="temporal-title">
      <div class="section-intro">
        <p class="eyebrow">06 / Temporal mini workers</p>
        <h2 id="temporal-title">Temporal runs the task lifecycle on small, single-purpose workers.</h2>
        <p>
          The scaled design needs durable per-question state, retries with backoff, liveness
          checks, a provider rate limit, and cancellation. Built by hand, that is a state table,
          retry-wait states, lease renewal, an outbox publisher, and a distributed limiter.
          Temporal provides each of these as a primitive, so ExecutionService's workers become
          Temporal mini workers: small pools that each do one kind of work.
        </p>
        <p>
          Temporal is infrastructure inside ExecutionService, not a fourth service. Only
          ExecutionService talks to it, so the three-service boundary holds.
        </p>
      </div>

      <figure class="diagram fit" id="temporal-pools">
        <div class="diagram-scroll"><pre class="mermaid">{temporalPoolsDiagram}</pre></div>
        <figcaption><span class="mono-label">Mini worker pools</span> <span>One task queue per kind of work. The generate queue carries the provider's rate limit.</span></figcaption>
      </figure>

      <h3 class="evolution-title">Why Temporal, reason by reason</h3>
      <ol class="reason-grid">
        {temporalReasons.map((reason, index) => (
          <li>
            <span class="mono-label">{String(index + 1).padStart(2, '0')}</span>
            <h4>{reason.title}</h4>
            <p>{reason.body}</p>
            <p class="replaces"><strong>Replaces:</strong> {reason.replaces}</p>
          </li>
        ))}
      </ol>

      <figure class="diagram fit" id="temporal-flow">
        <div class="diagram-scroll"><pre class="mermaid">{temporalFlowDiagram}</pre></div>
        <figcaption><span class="mono-label">Workflow shape</span> <span>A parent workflow per evaluation, a child per batch, and three activities per question.</span></figcaption>
      </figure>

      <div class="two-col">
        <div>
          <h3>Costs and limits</h3>
          <ul class="tick-list">
            {temporalLimits.map((limit) => <li>{limit}</li>)}
          </ul>
        </div>
        <div>
          <h3>What stays the same</h3>
          <p>
            Admission control and per-tenant quotas at the API, idempotent commits in the Results
            DB, the binary verdict data model, content-addressed snapshots in Blob, and the
            deduplicating inbox in AggregationService. Temporal changes how work is orchestrated,
            not what an evaluation means.
          </p>
        </div>
      </div>
    </section>

    <section id="claims" class="study-section tinted" aria-labelledby="claims-title">
      <div class="section-intro">
        <p class="eyebrow">07 / Scalability claims</p>
        <h2 id="claims-title">What scales, how far, and what stops it.</h2>
        <p>
          These are design claims, derived from the mechanisms above. Each one names the bound
          that limits it and the condition that breaks it. Measured results follow in section 08.
        </p>
      </div>

      <div class="table-wrap">
        <table class="claims">
          <thead><tr><th scope="col">Claim</th><th scope="col">Mechanism</th><th scope="col">Bound</th><th scope="col">Breaks when</th></tr></thead>
          <tbody>
            {claims.map((row) => (
              <tr><th scope="row">{row.claim}</th><td>{row.mechanism}</td><td>{row.bound}</td><td>{row.breaks}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <aside class="sizing" aria-label="Worked sizing example">
        <p class="mono-label">Worked sizing: Math500 against one provider</p>
        <h3>The ceiling is the provider, not the worker count.</h3>
        <p>
          Assume 5 seconds per generation and 20 concurrent calls per run. One 500-question run
          needs about 500 × 5 / 20 = 125 seconds of generation. Ten runs at once hold
          10 × 20 = 200 calls in flight, which by Little's Law is 40 calls per second. If the
          provider allows 100 calls in flight, five such runs is the ceiling, however many workers
          are added. So the platform's job at scale is to queue fairly and never exceed that limit.
        </p>
      </aside>
    </section>

    <section id="results" class="study-section" aria-labelledby="results-title">
      <div class="section-intro">
        <p class="eyebrow">08 / Measured results</p>
        <h2 id="results-title">1,000 evaluations per hour, with a long P99 tail.</h2>
        <p>
          Measured on the running system: 1,000 evaluations per hour end to end. Latency per
          evaluation is 24 minutes at P50, 26 minutes at P95, and 60 minutes at P99.
        </p>
      </div>

      <figure class="diagram fit" id="latency">
        <div class="diagram-scroll"><pre class="mermaid">{latencyChart}</pre></div>
        <figcaption><span class="mono-label">Measured latency</span> <span>End-to-end time per evaluation at P50, P95, and P99.</span></figcaption>
      </figure>

      <div class="prose">
        <p>
          P50 and P95 sit two minutes apart, so 95% of evaluations follow a predictable path. P99
          is 2.3 times P95: the slowest 1% are not slightly slower, they behave like a different
          regime. Backed-up queues, throttling, and retries are the usual causes of a tail like
          this, and they lead the main issues below.
        </p>
        <p>
          By Little's Law, 1,000 evaluations per hour at about 24 minutes each means roughly 400
          evaluations in flight at once, and more given the tail. That is the concurrency the
          queues, worker pools, and provider limits have to hold.
        </p>
      </div>
    </section>

    <section id="issues" class="study-section tinted" aria-labelledby="issues-title">
      <div class="section-intro">
        <p class="eyebrow">09 / Main issues at scale</p>
        <h2 id="issues-title">Six issues at this scale, and how the design answers each.</h2>
        <p>
          Each issue names its symptom, the design's answer, and the signal that shows whether
          the answer is working.
        </p>
      </div>

      <ol class="issue-grid">
        {issues.map((issue, index) => (
          <li>
            <span class="mono-label">{String(index + 1).padStart(2, '0')}</span>
            <h3>{issue.title}</h3>
            <dl>
              <div><dt>Symptom</dt><dd>{issue.symptom}</dd></div>
              <div><dt>Design answer</dt><dd>{issue.answer}</dd></div>
              <div><dt>Signal</dt><dd>{issue.signal}</dd></div>
            </dl>
          </li>
        ))}
      </ol>

      <figure class="diagram fit" id="retry-state">
        <div class="diagram-scroll"><pre class="mermaid">{retryStateDiagram}</pre></div>
        <figcaption><span class="mono-label">Retry from saved state</span> <span>A retry run keeps the original pins, reuses what is saved, and links back to its parent for lineage.</span></figcaption>
      </figure>

      <figure class="diagram fit" id="observability">
        <div class="diagram-scroll"><pre class="mermaid">{observabilityDiagram}</pre></div>
        <figcaption><span class="mono-label">Telemetry and observability</span> <span>OpenTelemetry traces through the OTel Collector; Temporal SDK and service metrics into Prometheus; Grafana on top of both.</span></figcaption>
      </figure>
    </section>

    <section id="failure" class="study-section tinted" aria-labelledby="failure-title">
      <div class="section-intro">
        <p class="eyebrow">10 / What breaks at scale</p>
        <h2 id="failure-title">More workers means more duplicates. Design for them.</h2>
        <p>
          With competing consumers, a message will be delivered twice and a worker will die
          mid-task. "Idempotent" is not one property here. It is five, and each one guards a
          different failure.
        </p>
      </div>

      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Layer</th><th scope="col">Key</th><th scope="col">Guards against</th></tr></thead>
          <tbody>
            {idempotency.map((row) => (
              <tr><th scope="row">{row.layer}</th><td><code>{row.key}</code></td><td>{row.guards}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="two-col">
        <div>
          <h3>Persist the answer before grading</h3>
          <p>
            Each task moves through the states in <a href="#figure-3">Figure 3</a>, with
            retry-wait states on both the generation and grading steps. The generated answer
            is stored before grading starts. If the grader fails, the retry resumes at grading
            against the stored answer. It never pays for a second LLM call, and it never grades a
            different, nondeterministic answer.
          </p>
        </div>
        <div>
          <h3>Outbox in, inbox out</h3>
          <p>
            The worker commits the task result and an outbox event in one transaction. A publisher
            calls AggregationService and retries with backoff until accepted. AggregationService
            inserts into an inbox keyed by <code>event_id</code>, so a duplicate is acknowledged
            and dropped. That is at-least-once delivery with idempotent processing
            (<a href="#figure-4">Figure 4</a>).
          </p>
        </div>
      </div>

      <figure class="diagram" id="figure-3">
        <div class="diagram-scroll"><pre class="mermaid">{lifecycleDiagram}</pre></div>
        <figcaption><span class="mono-label">Figure 3</span> Worker task lifecycle. A grading retry never goes back through generation.</figcaption>
      </figure>

      <figure class="diagram fit" id="figure-4">
        <div class="diagram-scroll"><pre class="mermaid">{outboxDiagram}</pre></div>
        <figcaption><span class="mono-label">Figure 4</span> Transactional outbox in ExecutionService, deduplicating inbox in AggregationService.</figcaption>
      </figure>

      <aside class="definition-band" aria-label="Exactly-once caveat">
        <p class="mono-label">The caveat I state up front</p>
        <p>
          I do not promise exactly-once LLM calls. The provider may finish a request after my
          worker times out. I record every attempt, use provider idempotency keys where they
          exist, and make commits idempotent. The goal is effectively-once business state, not
          exactly-once side effects.
        </p>
      </aside>
    </section>

    <section id="metrics" class="study-section" aria-labelledby="metrics-title">
      <div class="section-intro">
        <p class="eyebrow">11 / Honest metrics</p>
        <h2 id="metrics-title">Count from task events, not from worker counters.</h2>
        <p>
          AggregationService derives counts from deduplicated terminal task events. A worker's
          cumulative counter can be repeated or arrive out of order. A task event cannot be
          counted twice.
        </p>
      </div>
      <dl class="formula-grid">
        <div><dt>accuracy</dt><dd>correct / graded</dd></div>
        <div><dt>coverage</dt><dd>graded / total</dd></div>
        <div><dt>terminal invariant</dt><dd>graded + failed + cancelled = total</dd></div>
      </dl>
      <div class="prose">
        <p>
          A failed question is not a wrong answer. If it were counted as wrong, a provider
          outage would look like a model regression. Reporting coverage next to accuracy keeps
          the two visible. The run finalizes only when every task is terminal, or when the
          cancellation policy says it is.
        </p>
        <p>
          I also keep a reproducibility fingerprint over snapshot hash, model config and version,
          grader UUID and version, and execution config. It is <em>not</em> an idempotency key.
          Running the same config twice on purpose is a valid experiment. Only the API
          idempotency key identifies a retried request.
        </p>
      </div>
    </section>

    <section id="decisions" class="study-section tinted" aria-labelledby="decisions-title">
      <div class="section-intro">
        <p class="eyebrow">12 / Decision log</p>
        <h2 id="decisions-title">The trade-offs, in one place.</h2>
      </div>
      <dl class="decision-grid">
        {decisions.map((item) => (
          <div><dt>{item.q}</dt><dd>{item.a}</dd></div>
        ))}
      </dl>

      <div class="staff-lesson">
        <p class="eyebrow">What I would carry to the next design</p>
        <h3>Scale-out is mostly a boundary and correctness problem, not a worker-count problem.</h3>
        <p>
          Adding workers is the easy part. The design work is deciding who owns which state,
          finding the dependency that actually limits throughput, and making every retry safe.
          Out of scope on purpose: a server-side orchestration service. The client can chain
          ingest and execute; I would add an orchestrator only if the problem required it.
        </p>
      </div>
    </section>

    <section id="design-doc" class="study-section" aria-labelledby="design-doc-title">
      <div class="section-intro">
        <p class="eyebrow">13 / Full design doc</p>
        <h2 id="design-doc-title">The complete design, as written.</h2>
        <p>
          Everything above is my reading of this document. Here is the source in full: APIs,
          request and response shapes, SSRF rules, grader safety, retry policy, and data model.
          Its diagrams are the four figures above.
        </p>
      </div>
      <article class="design-doc">
        <DesignDoc />
      </article>
    </section>
  </main>

