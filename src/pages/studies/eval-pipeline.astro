<script>
  // Native Mermaid rendering in the browser. Mermaid is bundled by Vite and
  // served from this site, so the page makes no third-party requests. Without
  // JavaScript the diagram source stays visible as plain text.
  import mermaid from 'mermaid';

  mermaid.initialize({
    startOnLoad: false,
    securityLevel: 'strict',
    theme: 'neutral',
    fontFamily: "'Source Sans 3 Variable', sans-serif",
    flowchart: { useMaxWidth: false },
    sequence: { useMaxWidth: false, wrap: true, width: 140, actorMargin: 40 },
    state: { useMaxWidth: false },
    er: { useMaxWidth: false },
  });

  // Flag figures that still overflow their frame so the caption can say so.
  const markScrollable = () => {
    for (const frame of document.querySelectorAll<HTMLElement>('.diagram-scroll')) {
      const figure = frame.closest('figure');
      if (figure) figure.dataset.scrollable = String(frame.scrollWidth > frame.clientWidth + 4);
    }
  };

  mermaid.run({ querySelector: 'pre.mermaid' }).then(() => {
    markScrollable();
    window.addEventListener('resize', markScrollable, { passive: true });
    document.documentElement.dataset.mermaid = 'rendered';
  });
</script>

