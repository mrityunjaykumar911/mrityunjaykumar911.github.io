// ---------------------------------------------------------------------------
// Judge alignment (section 13). Every number comes from
// src/data/studies/eval-alignment.json, written by
// scripts/study-eval-alignment/analyze.py, so the page cannot drift from the data.
type Dim = keyof typeof alignment.dimensions;
const dimOrder: Dim[] = ['coherence', 'consistency', 'fluency', 'relevance'];
const dimLabel: Record<Dim, string> = {
  coherence: 'Coherence', consistency: 'Consistency', fluency: 'Fluency', relevance: 'Relevance',
};
// Avoid printing -0.00 for values that round to zero.
const fmt = (x: number, digits = 2) => (Math.abs(x) < 0.5 * 10 ** -digits ? 0 : x).toFixed(digits);
const pct = (x: number) => `${Math.round(x * 100)}%`;
const range = (values: number[], f: (x: number) => string = (x) => fmt(x)) =>
  `${f(Math.min(...values))} to ${f(Math.max(...values))}`;
const dims = dimOrder.map((d) => ({ key: d, label: dimLabel[d], ...alignment.dimensions[d] }));

// Chart colors: validated with the dataviz palette checker against the white
// chart surface (lightness band, chroma floor, CVD and normal-vision separation, contrast).
const SERIES = {
  hh: { label: 'Expert vs expert', color: '#2a78d6' },
  hm: { label: 'Judge vs expert', color: '#087a55' },
};

function agreementPanel(stratum: 'unanimous' | 'split'): string {
  const W = 560, rowH = 46, top = 8, left = 104, right = 56;
  const plotW = W - left - right;
  const H = top + dims.length * rowH + 30;
  const x = (v: number) => left + v * plotW;
  const parts: string[] = [];
  for (const t of [0, 0.25, 0.5, 0.75, 1]) {
    parts.push(`<line x1="${x(t)}" x2="${x(t)}" y1="${top}" y2="${H - 26}" class="grid" />`);
    parts.push(`<text x="${x(t)}" y="${H - 8}" class="tick" text-anchor="middle">${fmt(t)}</text>`);
  }
  dims.forEach((d, i) => {
    const b = d.binary[stratum];
    const y0 = top + i * rowH + 8;
    parts.push(`<text x="${left - 10}" y="${y0 + 13}" class="cat" text-anchor="end">${d.label}</text>`);
    parts.push(`<text x="${left - 10}" y="${y0 + 28}" class="n" text-anchor="end">n = ${b.n}</text>`);
    (['hh', 'hm'] as const).forEach((k, j) => {
      const v = k === 'hh' ? b.hh_agreement : b.hm_agreement;
      const y = y0 + j * 14;
      const w = Math.max(v * plotW, 2);
      const tip = `${d.label}, ${stratum} items: ${SERIES[k].label} agreement ${fmt(v)} (n = ${b.n})`;
      parts.push(`<g class="bar"><title>${tip}</title><rect x="${left}" y="${y}" width="${w}" height="12" rx="2" fill="${SERIES[k].color}" /><rect x="${left}" y="${y - 1}" width="${plotW}" height="14" fill="transparent" /></g>`);
      parts.push(`<text x="${left + w + 6}" y="${y + 10}" class="val">${fmt(v)}</text>`);
    });
    const r = b.random_agreement;
    parts.push(`<g class="bar"><title>${d.label}, ${stratum} items: random labeler at the judge's pass rate ${fmt(r)}</title><line x1="${x(r)}" x2="${x(r)}" y1="${y0 - 3}" y2="${y0 + 29}" class="random" /></g>`);
  });
  const title = stratum === 'unanimous' ? 'Items where all three experts agree' : 'Items where the experts split 2 to 1';
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${title}: agreement by dimension" class="agreement-svg">${parts.join('')}</svg>`;
}
const unanimousPanel = agreementPanel('unanimous');
const splitPanel = agreementPanel('split');

const split = dims.map((d) => d.binary.split);
const alignmentFacts = {
  judgePass: dims.map((d) => d.binary.all.judge_pass_rate),
  humanPass: dims.map((d) => d.binary.all.human_pass_rate),
  aucUnanimous: dims.map((d) => d.discrimination.auc_unanimous),
  aucSplit: dims.map((d) => d.discrimination.auc_split),
  kappaRaw: dims.map((d) => d.binary.all.hm_kappa),
  kappaRecal: dims.map((d) => d.recalibrated.hm_kappa_all),
  kappaHH: dims.map((d) => d.binary.all.hh_kappa),
  splitHM: split.map((b) => b.hm_agreement),
  splitRandom: split.map((b) => b.random_agreement),
  splitKappa: split.map((b) => b.hm_kappa),
  splitShare: dims.map((d) => d.binary.split.n / d.binary.all.n),
  tau: dims.map((d) => d.system.kendall_tau_score),
  rawErr: dims.map((d) => d.correction_check.mean_abs_error_raw),
  corErr: dims.map((d) => d.correction_check.mean_abs_error_corrected),
  covClosed: dims.map((d) => d.correction_check.closed_form_ci95_coverage),
  covBoot: dims.map((d) => d.correction_check.cluster_bootstrap_ci95_coverage),
};

// Formulas shown in the measurement-validity section, rendered at build time.
const validityFormulas = [
  { name: 'Error bar', note: 'Miller 2024', html: tex(String.raw`\mathrm{SE}(\hat{\mu}) = \sqrt{\frac{\hat{\mu}(1-\hat{\mu})}{n}}`, true) },
  { name: 'Paired difference', note: 'Miller 2024', html: tex(String.raw`\mathrm{SE}(\bar{d}) = \frac{\operatorname{sd}(d_1,\dots,d_n)}{\sqrt{n}}`, true) },
  { name: 'Corrected accuracy', note: 'Lee et al. 2025', html: tex(String.raw`\hat{\theta} = \frac{\hat{p} + \hat{q}_0 - 1}{\hat{q}_0 + \hat{q}_1 - 1}`, true) },
  { name: 'Audit sample (PPI)', note: 'Boyeau et al. 2025', html: tex(String.raw`\hat{\theta} = \tfrac{1}{N}\textstyle\sum_i \hat{Z}_i + \tfrac{1}{n}\sum_j (Z_j - \hat{Z}_j)`, true) },
  { name: 'Trust or escalate', note: 'Jung et al. 2025', html: tex(String.raw`P(\hat{Z} = Z \mid c \ge \lambda) \ge 1 - \alpha`, true) },
];


// Workload model. "Estimate" values come from environment math, not from a
// measured run. Everything else is derived from them or is a stated design
// default, and is labeled so.
const RUN_QUESTIONS = 500;
const RUNS_PER_HOUR = 1000;
const P50_MIN = 24;
const CALLS_PER_RUN = 20; // execution_config.max_concurrency, a design default
const questionsPerSecond = (RUNS_PER_HOUR * RUN_QUESTIONS) / 3600;
const runsInFlight = (RUNS_PER_HOUR / 60) * P50_MIN;
const callsInFlight = runsInFlight * CALLS_PER_RUN;
const secondsPerCall = (P50_MIN * 60) / (RUN_QUESTIONS / CALLS_PER_RUN);
const requestsPerMinute = questionsPerSecond * 60;
const n0 = (x: number) => Math.round(x).toLocaleString('en-US');
// In TeX a bare comma is punctuation and gets a trailing space; braces keep 8{,}000 tight.
const t0 = (x: number) => n0(x).replace(/,/g, '{,}');
const workloadRows = [
  { q: 'One evaluation', v: `A full run of about ${RUN_QUESTIONS} questions (Math500-sized)`, src: 'Definition' },
  { q: 'Target throughput', v: `${RUNS_PER_HOUR.toLocaleString('en-US')} evaluations per hour`, src: 'Estimate' },
  { q: 'Estimated latency per evaluation', v: '24 min P50, 26 min P95, 60 min P99', src: 'Estimate' },
  { q: 'Model calls per evaluation', v: `About ${RUN_QUESTIONS}, at most ${CALLS_PER_RUN} in flight`, src: 'Design default' },
  { q: 'Questions per second', v: tex(String.raw`\tfrac{1000 \times 500}{3600} \approx ${t0(questionsPerSecond)}`), src: 'Derived', math: true },
  { q: 'Evaluations in flight', v: tex(String.raw`L = \lambda W = \tfrac{1000}{60} \times 24 \approx ${t0(runsInFlight)}`), src: "Derived (Little's Law)", math: true },
  { q: 'Model calls in flight', v: tex(String.raw`${t0(runsInFlight)} \times ${CALLS_PER_RUN} \approx ${t0(callsInFlight)}`), src: 'Derived', math: true },
  { q: 'Time per model call', v: tex(String.raw`\tfrac{24 \times 60}{500 / 20} \approx ${t0(secondsPerCall)}\ \text{s}`), src: 'Derived, if generation-bound', math: true },
  { q: 'Provider requests per minute', v: tex(String.raw`\approx ${t0(requestsPerMinute)}\ \text{RPM, plus retries}`), src: 'Derived', math: true },
  { q: 'Provider, model, and quota', v: 'Not published', src: 'Undisclosed' },
];

// What happens when each step fails after part of its work is done.
const retrySemantics = [
  { when: 'A model call times out, but the provider finished it', what: 'The activity retries with a new attempt_id. The answer commit is conditional on the task having no committed answer, so the late response is discarded.', cost: 'A second billed call, never a second answer. Provider idempotency keys remove it where supported.' },
  { when: 'Generate commits its answer, then the worker dies before Temporal records completion', what: 'Temporal retries the activity. It reads the Results DB first, finds the committed answer for (execution_id, record_id, sample_idx), and returns that generation_id without calling the model.', cost: 'One DB read.' },
  { when: 'Grade commits its verdict, then the worker dies', what: 'The retry inserts the verdict only if absent, keyed by (generation_id, grader_version, grader_config_hash), and returns the stored one.', cost: 'Nothing; grading never reruns generation.' },
  { when: 'Publish is retried after AggregationService accepted the event', what: 'The inbox already holds that event_id, so the duplicate is acknowledged and dropped.', cost: 'One extra request.' },
  { when: 'A workflow worker crashes', what: 'Another worker replays the history. Workflow code has no side effects, so replay repeats nothing external.', cost: 'Replay time, bounded by child workflows of at most 500 questions.' },
];

const glance = [
  { k: 'Problem', v: 'Binary 0/1 evaluation of an LLM over a dataset, pinned to a snapshot, model version, and grader version.' },
  { k: 'Architecture', v: 'Three services (ingestion, execution, aggregation). Temporal mini workers orchestrate execution; the Results DB holds every answer and verdict.' },
  { k: 'Workload', v: `One evaluation is a ${RUN_QUESTIONS}-question run. Sized for an estimated 1,000 per hour: about ${n0(questionsPerSecond)} questions per second and about ${n0(callsInFlight)} model calls in flight.` },
  { k: 'Main trade-offs', v: 'The provider quota, not the worker count, sets throughput. Effectively-once state instead of exactly-once calls. Answers are stored before grading.' },
];

const homeHref = withBase('/');
const methodHref = withBase('/method.html');
const year = new Date().getFullYear();

const chapters = [
  { id: 'problem', label: 'The problem' },
  { id: 'evaluation', label: 'Binary eval' },
  { id: 'baseline', label: 'Baseline v0' },
  { id: 'boundaries', label: 'Boundaries first' },
  { id: 'scale-out', label: 'Scaling out' },
  { id: 'temporal', label: 'Temporal workers' },
  { id: 'claims', label: 'Scalability claims' },
  { id: 'results', label: 'Sizing estimate' },
  { id: 'issues', label: 'Main issues' },
  { id: 'failure', label: 'What breaks at scale' },
  { id: 'metrics', label: 'Honest metrics' },
  { id: 'decisions', label: 'Decision log' },
  { id: 'validity', label: 'Advanced: validity' },
  { id: 'alignment', label: 'Advanced: judge alignment' },
  { id: 'design-doc', label: 'Full design doc' },
];

const services = [
  {
    name: 'IngestionService',
    role: 'Turns a dataset URL into an immutable snapshot.',
    owns: ['REST API', 'Ingestion queue', 'Ingestion workers', 'Metadata DB'],
    load: 'Bursty, network bound. Scales with fetch and parse throughput.',
  },
  {
    name: 'ExecutionService',
    role: 'Generates an answer per question, then grades it.',
    owns: ['REST API', 'Execution queue', 'Execution workers', 'Results DB + outbox'],
    load: 'The hot path. Bound by LLM provider limits and grader CPU.',
  },
  {
    name: 'AggregationService',
    role: 'Turns task events into progress and a final report.',
    owns: ['REST API', 'Aggregation queue', 'Aggregation workers', 'Inbox + counters DB'],
    load: 'Cheap per event. Scales with event rate, not with model latency.',
  },
];

const externals = [
  { name: 'Dataset source URL', note: 'Untrusted input. Fetched once, behind SSRF checks.' },
  { name: 'Azure Blob Storage', note: 'Managed storage, not a service. Holds content-addressed snapshots.' },
  { name: 'External LLM API', note: 'Called directly by execution workers. The real bottleneck.' },
  { name: 'Python grading library', note: 'Runs inside the worker process. Not a network hop.' },
];

const idempotency = [
  { layer: 'API request', key: '(tenant_id, idempotency_key)', guards: 'A client retrying the same create call.' },
  { layer: 'Dataset content', key: '(tenant, normalized_hash, schema_version)', guards: 'Two ingestions of the same bytes.' },
  { layer: 'Task', key: '(execution_id, record_id, sample_idx)', guards: 'A queue delivering the same task twice.' },
  { layer: 'Grading result', key: '(generation_id, grader_version, config_hash)', guards: 'Re-grading the same stored answer.' },
  { layer: 'Event', key: 'event_id', guards: 'The outbox re-sending an event after a lost ack.' },
];

const decisions = [
  { q: 'Why async APIs?', a: 'Downloads, model calls, and grading take minutes. Return 202 and expose durable status instead of holding connections open.' },
  { q: 'Why snapshot datasets?', a: 'A URL can serve different bytes tomorrow. A content-addressed snapshot makes every evaluation reproducible.' },
  { q: 'Why let execution read Blob directly?', a: 'Large payloads should not be proxied through ingestion. It keeps ingestion off the hot path and lets each side scale alone.' },
  { q: 'Why keep model config out of ingestion?', a: 'A dataset is reusable across models and graders. Ingestion should not know about either.' },
  { q: 'Why a grader UUID, not code?', a: 'The platform owns the mapping from ID to an approved, versioned artifact. Callers never supply executable code.' },
  { q: 'Why an outbox, not a direct call?', a: 'The network can fail after the result is committed. Outbox plus inbox gives retryable delivery with deduplication.' },
  { q: 'Why not promise exactly-once?', a: 'An LLM call can succeed on the provider after my worker times out. I make internal state effectively-once instead.' },
  { q: 'Why Temporal mini workers?', a: 'Durable orchestration state, declared retries, and timeouts, instead of building each by hand. Each small pool scales on its own bottleneck. Domain data stays in the Results DB.' },
  { q: 'Why key the limiter on the provider quota?', a: 'The provider enforces requests per minute, tokens per minute, and calls in flight per account and model. A per-queue rate counts none of those, and it misses models that share one quota.' },
  { q: 'Why a signed dataset reference?', a: 'A client-supplied blob URI cannot prove tenant ownership or that ingestion produced it. A signed reference carries the tenant, content hash, and object identity, and execution verifies it.' },
  { q: 'Why split accuracy from coverage?', a: 'Failed questions are not wrong answers. Mixing them silently moves the denominator.' },
  { q: 'Why validate the grader by agreement stratum?', a: 'Where experts disagree, any labeler looks as good as a human. Only items where experts agree show real grader error, so the acceptance test runs there.' },
  { q: 'Why a cluster bootstrap for corrected accuracy?', a: 'Answers from one source document are correlated. On SummEval the closed-form interval covered the truth 69% to 84% of the time; resampling whole documents restored about 95%.' },
];
