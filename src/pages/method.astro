---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MethodCaseStudies from '../components/MethodCaseStudies.astro';
import { withBase } from '../lib/url';

const homeHref = withBase('/');
const year = new Date().getFullYear();
const chapters = [
  { id: 'mandate', label: 'What I care about' },
  { id: 'judgment', label: 'How I think' },
  { id: 'development', label: 'How I develop' },
  { id: 'scale', label: 'How systems scale' },
  { id: 'case-studies', label: 'Three studies' },
];
---

<Base
  title="How I Build ML Systems | Mrityunjay Kumar"
  description="How Senior ML Engineer Mrityunjay Kumar exercises judgment, develops production systems, creates organizational leverage, and approaches scale in the LLM era."
  canonicalPath="/method.html"
>
  <header class="method-header" id="top">
    <a class="method-wordmark" href={homeHref} aria-label="Return to portfolio">
      <span class="wordmark-mark">MK</span>
      <span>
        <strong>Mrityunjay Kumar</strong>
        <small>Applied science · ML systems</small>
      </span>
    </a>
    <a class="back-link" href={homeHref}>
      Portfolio <Icon name="arrow-up-right" size={15} />
    </a>
  </header>

  <main id="main" class="method-page">
    <section class="method-hero" aria-labelledby="method-title">
      <div class="hero-copy">
        <p class="eyebrow">Senior ML Engineer · Microsoft</p>
        <h1 id="method-title">Mrityunjay Kumar</h1>
        <p class="hero-thesis">I build ML systems that remain useful after the demo.</p>
        <p class="hero-lede">
          My work is moving from solving hard model problems to shaping the systems around them:
          product intent, evaluation, reliability, cost, and the engineering leverage that lets
          teams improve all five together.
        </p>
        <a class="text-link" href="#mandate">Read my operating approach <span aria-hidden="true">↓</span></a>
      </div>

      <figure class="hero-system" aria-label="Mrityunjay's operating model for production ML systems">
        <figcaption>How I frame the system</figcaption>
        <ol>
          <li><span>01</span><div><strong>Product intent</strong><small>The decision or workflow that must improve</small></div></li>
          <li><span>02</span><div><strong>Evaluation</strong><small>Evidence that separates progress from theatre</small></div></li>
          <li><span>03</span><div><strong>ML execution</strong><small>Models, data, tools, and bounded autonomy</small></div></li>
          <li><span>04</span><div><strong>Operations</strong><small>Reliability, latency, cost, and recovery</small></div></li>
          <li><span>05</span><div><strong>Team leverage</strong><small>Interfaces and paved paths that compound</small></div></li>
        </ol>
        <p><span>Outcome</span> A useful capability that can be measured, operated, and improved.</p>
      </figure>

    </section>

    <nav class="method-nav" aria-label="Method chapters">
      <ol>
        {chapters.map((chapter, index) => (
          <li>
            <a href={`#${chapter.id}`}>
              <span aria-hidden="true">0{index + 1}</span>{chapter.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="mandate" class="method-section mandate-section" aria-labelledby="mandate-title">
      <div class="section-intro">
        <p class="eyebrow">01 / What I care about</p>
        <h2 id="mandate-title">Capability matters. Durable value matters more.</h2>
        <p>
          A model can be impressive and still leave the product fragile. I care about the whole
          system that turns intelligence into a dependable user outcome, including the parts
          that are less visible than the model itself.
        </p>
      </div>

      <ul class="mandate-list">
        <li><span>01</span><div><h3>Useful over theatrical</h3><p>Start with the decision or workflow that should improve, not with a model looking for a use case.</p></div></li>
        <li><span>02</span><div><h3>Reliability is product work</h3><p>Evaluation, fallbacks, latency, observability, and recovery shape trust as directly as model quality.</p></div></li>
        <li><span>03</span><div><h3>Economics are architecture</h3><p>Token use, compute, human review, and operational load belong in design decisions from the beginning.</p></div></li>
        <li><span>04</span><div><h3>Clarity creates leverage</h3><p>Explicit interfaces, ownership, and evidence let more engineers change the system without losing its intent.</p></div></li>
      </ul>
    </section>

    <section id="judgment" class="method-section judgment-section" aria-labelledby="judgment-title">
      <div class="section-intro light-intro">
        <p class="eyebrow">02 / How I think</p>
        <h2 id="judgment-title">Make the system legible before making it larger.</h2>
        <p>
          Staff-level judgment begins before implementation. I frame the decision, map the
          boundaries, and identify the evidence that would justify investment or stop it.
        </p>
      </div>

      <ol class="reasoning-chain" aria-label="Engineering judgment sequence">
        <li><span>Intent</span><p>Whose outcome changes, and how will we know?</p></li>
        <li><span>System</span><p>Where do state, data, models, and ownership meet?</p></li>
        <li><span>Risk</span><p>Which failure is costly, silent, or hard to reverse?</p></li>
        <li><span>Evidence</span><p>What is the cheapest observation that could change the decision?</p></li>
        <li><span>Commit</span><p>Build, narrow, or stop with the rationale recorded.</p></li>
      </ol>

      <div class="judgment-notes">
        <article><p class="mono-label">When signals disagree</p><h3>Investigate the measurement boundary.</h3><p>A reassuring aggregate should not erase a concrete failure. First ask whether the instruments answer the same question.</p></article>
        <article><p class="mono-label">When investment grows</p><h3>Raise the evidence bar.</h3><p>The more expensive and irreversible the direction, the more explicit its assumptions, rollback, and success criteria should become.</p></article>
        <article><p class="mono-label">When a hypothesis fails</p><h3>Change the plan, not the story.</h3><p>A negative result is useful when it prevents further waste. Technical leadership includes stopping work that has not earned scale.</p></article>
      </div>
    </section>

    <section id="development" class="method-section development-section" aria-labelledby="development-title">
      <div class="section-intro">
        <p class="eyebrow">03 / How I develop</p>
        <h2 id="development-title">Move from uncertain capability to an operable system.</h2>
        <p>
          I work in thin, observable slices. Each stage reduces a different risk, and each
          leaves behind an interface or check the next engineer can use.
        </p>
      </div>

      <ol class="delivery-rail" aria-label="Production development stages">
        <li><span class="stage-index">01</span><div><p class="mono-label">Frame</p><h3>Define the outcome and invariants.</h3><p>Turn an ambiguous request into a decision, a baseline, and constraints that survive implementation choices.</p></div></li>
        <li><span class="stage-index">02</span><div><p class="mono-label">Slice</p><h3>Prove the riskiest path end to end.</h3><p>Connect real data, model behavior, and user interaction before optimizing isolated components.</p></div></li>
        <li><span class="stage-index">03</span><div><p class="mono-label">Instrument</p><h3>Make quality and failure observable.</h3><p>Capture task success, regressions, cost, latency, and traces at the boundary where decisions are made.</p></div></li>
        <li><span class="stage-index">04</span><div><p class="mono-label">Harden</p><h3>Design for imperfect models and dependencies.</h3><p>Add validation, retries only where bounded, fallbacks, idempotency, isolation, and explicit unknown states.</p></div></li>
        <li><span class="stage-index">05</span><div><p class="mono-label">Operationalize</p><h3>Turn the solution into team leverage.</h3><p>Ship paved paths, ownership, runbooks, release gates, and telemetry so improvement no longer depends on one person.</p></div></li>
      </ol>

      <aside class="definition-band" aria-label="Definition of production ready">
        <p class="mono-label">Production-ready means</p>
        <p>Users can rely on it. Operators can diagnose it. Engineers can change it. Leaders can understand its cost and risk.</p>
      </aside>
    </section>

    <section id="scale" class="method-section scale-section" aria-labelledby="scale-title">
      <div class="section-intro">
        <p class="eyebrow">04 / Scaling in the LLM era</p>
        <h2 id="scale-title">Scale the learning system, not only the inference fleet.</h2>
        <p>
          LLM products change faster than traditional software and fail less deterministically.
          Sustainable scale comes from shortening the path from production evidence to a safe,
          measurable improvement.
        </p>
      </div>

      <div class="scale-map" aria-label="LLM system layers">
        <div><span>01</span><p class="mono-label">Intent</p><h3>Task contracts</h3><p>Define success in user and domain terms.</p></div>
        <div><span>02</span><p class="mono-label">Evaluation</p><h3>Evidence loops</h3><p>Pair offline suites with production signals.</p></div>
        <div><span>03</span><p class="mono-label">Execution</p><h3>Bounded autonomy</h3><p>Constrain tools, state, retries, and side effects.</p></div>
        <div><span>04</span><p class="mono-label">Operations</p><h3>Observable economics</h3><p>Track quality, latency, tokens, and recovery together.</p></div>
        <div><span>05</span><p class="mono-label">Organization</p><h3>Paved roads</h3><p>Make safe patterns easier to reuse than bypass.</p></div>
      </div>

      <div class="staff-leverage">
        <div><p class="eyebrow">The evolution I am pursuing</p><h3>From owning components to improving how teams make technical decisions.</h3></div>
        <p>
          The staff role I am growing toward is not “more implementation.” It is broader
          judgment: finding the constraint that matters, aligning interfaces and ownership,
          creating reusable engineering paths, and making trade-offs visible early enough
          for the organization to act on them.
        </p>
      </div>
    </section>

    <MethodCaseStudies />
  </main>

  <SiteFooter name="Mrityunjay Kumar" year={year} />
</Base>

<style>
  .method-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(18px) saturate(1.25);
  }

  .method-wordmark,
  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }

  .method-wordmark {
    gap: 11px;
  }

  .method-wordmark > span:last-child {
    display: grid;
    line-height: 1.15;
  }

  .method-wordmark strong {
    font-family: var(--display);
    font-size: 15px;
    font-weight: 650;
  }

  .method-wordmark small {
    margin-top: 3px;
    color: var(--ink-faint);
    font-size: 13px;
  }

  .wordmark-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--ink);
    color: #fff;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 600;
  }

  .back-link {
    gap: 7px;
    color: var(--ink-soft);
    font-size: 14px;
    font-weight: 550;
  }

  .method-hero,
  .method-section,
  .method-nav {
    padding-inline: var(--gutter);
  }

  .method-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.72fr);
    grid-template-rows: minmax(500px, 1fr) auto;
    column-gap: clamp(48px, 7vw, 112px);
    align-items: center;
    min-height: min(680px, calc(100svh - 104px));
    padding-top: clamp(48px, 6vw, 84px);
    overflow: hidden;
    background: #f4f6f3;
    color: var(--ink);
  }

  .hero-system {
    align-self: center;
    min-width: 0;
    margin: 0;
    padding: 0 0 30px clamp(32px, 4vw, 64px);
    border-left: 1px solid var(--line-strong);
  }

  .hero-system figcaption {
    margin-bottom: 22px;
    color: var(--accent-strong);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .hero-system ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .hero-system li {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .hero-system li > span,
  .hero-system > p > span {
    color: var(--accent-strong);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .hero-system li div {
    display: grid;
    grid-template-columns: minmax(120px, 0.7fr) minmax(0, 1fr);
    gap: 18px;
    align-items: baseline;
  }

  .hero-system strong {
    font-family: var(--display);
    font-size: 17px;
  }

  .hero-system small {
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.35;
  }

  .hero-system > p {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 12px;
    margin: 20px 0 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: 18px;
    font-weight: 560;
    line-height: 1.35;
  }

  .hero-copy {
    max-width: 700px;
    padding-bottom: 36px;
  }

  .eyebrow {
    margin-bottom: 20px;
    color: var(--accent);
  }

  h1,
  h2,
  h3 {
    font-family: var(--display);
    overflow-wrap: break-word;
  }

  h1,
  h2,
  h3 {
    letter-spacing: 0;
  }

  h1 {
    font-size: clamp(48px, 7vw, 92px);
    font-weight: 680;
    line-height: 0.98;
  }

  .hero-thesis {
    max-width: 24ch;
    margin-top: 20px;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(24px, 3.2vw, 42px);
    font-weight: 560;
    line-height: 1.1;
  }

  .hero-lede {
    max-width: 54ch;
    margin-top: 28px;
    color: var(--ink-soft);
    font-size: clamp(18px, 1.4vw, 21px);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin-top: 24px;
    font-weight: 600;
    text-decoration-color: var(--accent);
    text-underline-offset: 5px;
  }

  .method-hero .eyebrow,
  .method-hero .text-link {
    color: var(--accent-strong);
  }

  .method-nav {
    border-block: 1px solid var(--line);
    background: var(--panel);
  }

  .method-nav ol {
    display: flex;
    flex-wrap: wrap;
    column-gap: 24px;
    list-style: none;
    padding-block: 12px;
  }

  .method-nav li {
    flex: 1 1 130px;
  }

  .method-nav a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .method-nav a:hover {
    color: var(--accent);
  }

  .method-nav a span {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 12px;
  }

  .method-section {
    padding-block: clamp(64px, 7vw, 96px);
    scroll-margin-top: 24px;
  }

  .section-intro {
    max-width: 760px;
  }

  .section-intro h2 {
    max-width: 25ch;
    font-size: clamp(30px, 3.3vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .section-intro > p:not(.eyebrow) {
    margin-top: 22px;
    color: var(--ink-soft);
    font-size: 17px;
  }

  .mandate-section,
  .development-section {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .mandate-list,
  .delivery-rail {
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .mandate-list li,
  .delivery-rail li {
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }

  .mandate-list li {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 20px;
  }

  .mandate-list > li > span,
  .stage-index,
  .scale-map > div > span {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 12px;
    padding-top: 5px;
  }

  h3 {
    font-size: 20px;
    line-height: 1.3;
  }

  .mandate-list p,
  .delivery-rail p,
  .judgment-notes article > p:last-child,
  .scale-map div > p:last-child {
    margin-top: 12px;
    color: var(--ink-soft);
  }

  .judgment-section {
    background: #12191f;
    color: #fff;
  }

  .light-intro > p:not(.eyebrow),
  .judgment-notes article > p:last-child {
    color: rgba(255, 255, 255, 0.7);
  }

  .judgment-section .eyebrow,
  .judgment-section .mono-label {
    color: #7dd6eb;
  }

  .reasoning-chain {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 48px;
    list-style: none;
    border-block: 1px solid rgba(255, 255, 255, 0.18);
  }

  .reasoning-chain li {
    min-height: 150px;
    padding: 22px 20px 24px 0;
  }

  .reasoning-chain li + li {
    padding-left: 20px;
    border-left: 1px solid rgba(255, 255, 255, 0.18);
  }

  .reasoning-chain span {
    color: #7dd6eb;
    font-family: var(--mono);
    font-size: 13px;
  }

  .reasoning-chain p {
    margin-top: 24px;
    color: rgba(255, 255, 255, 0.82);
    font-weight: 560;
    line-height: 1.35;
  }

  .judgment-notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin-top: 40px;
  }

  .judgment-notes article {
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .judgment-notes h3 {
    margin-top: 16px;
  }

  .development-section {
    grid-template-areas: "intro rail" "definition definition";
  }

  .development-section .section-intro {
    grid-area: intro;
  }

  .delivery-rail {
    grid-area: rail;
  }

  .delivery-rail li {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 20px;
  }

  .delivery-rail .mono-label {
    color: var(--accent);
  }

  .definition-band {
    grid-area: definition;
    display: grid;
    grid-template-columns: minmax(160px, 0.35fr) minmax(0, 1.65fr);
    gap: 32px;
    margin-top: 16px;
    padding: 28px 0;
    border-block: 1px solid var(--line-strong);
  }

  .definition-band .mono-label {
    color: var(--accent);
  }

  .definition-band p:last-child {
    max-width: 48ch;
    font-family: var(--display);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 590;
    line-height: 1.25;
  }

  .scale-section {
    background: #edf3f1;
    border-block: 1px solid var(--line);
  }

  .scale-map {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 48px;
    border-block: 1px solid var(--line-strong);
  }

  .scale-map > div {
    min-height: 210px;
    padding: 24px 18px 26px 0;
  }

  .scale-map > div + div {
    padding-left: 18px;
    border-left: 1px solid var(--line-strong);
  }

  .scale-map .mono-label {
    margin-top: 26px;
    color: var(--accent);
  }

  .scale-map h3 {
    margin-top: 8px;
  }

  .staff-leverage {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 7vw, 96px);
    margin-top: 56px;
    padding-top: 40px;
    border-top: 3px solid var(--ink);
  }

  .staff-leverage h3 {
    max-width: 28ch;
    margin-top: 14px;
    font-size: clamp(25px, 2.8vw, 36px);
  }

  .staff-leverage > p {
    color: var(--ink-soft);
    font-size: 17px;
  }

  @media (min-width: 1800px) {
    .method-header {
      min-height: 84px;
    }
  }

  @media (max-width: 900px) {
    .method-hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      min-height: auto;
      column-gap: 0;
      padding-top: 56px;
    }

    .hero-copy {
      padding-bottom: 40px;
    }

    .hero-system {
      margin-inline: 0;
      padding: 0 0 44px;
      border-top: 1px solid var(--line-strong);
      border-left: 0;
    }

    .hero-system figcaption {
      margin-top: 28px;
    }

    .mandate-section,
    .development-section,
    .judgment-notes,
    .staff-leverage {
      grid-template-columns: minmax(0, 1fr);
    }

    .development-section {
      grid-template-areas: "intro" "rail" "definition";
    }

    .reasoning-chain,
    .scale-map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .reasoning-chain li,
    .scale-map > div {
      min-height: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    }

    .scale-map > div {
      border-bottom-color: var(--line-strong);
    }

    .reasoning-chain li:nth-child(odd),
    .scale-map > div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .reasoning-chain li:nth-child(even),
    .scale-map > div:nth-child(even) {
      padding-left: 20px;
      border-left: 1px solid rgba(255, 255, 255, 0.18);
    }

    .scale-map > div:nth-child(even) {
      border-left-color: var(--line-strong);
    }
  }

  @media (max-width: 620px) {
    .method-wordmark > span:last-child {
      display: none;
    }

    .method-nav ol {
      column-gap: 16px;
    }

    .method-nav li {
      flex-basis: 120px;
    }

    .method-hero {
      padding-top: 56px;
    }

    .hero-system li div {
      grid-template-columns: minmax(0, 1fr);
      gap: 3px;
    }

    .reasoning-chain,
    .scale-map,
    .definition-band {
      grid-template-columns: minmax(0, 1fr);
    }

    .reasoning-chain li:nth-child(even),
    .scale-map > div:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }

    .reasoning-chain li,
    .scale-map > div {
      padding-inline: 0;
    }

    .staff-leverage {
      gap: 24px;
    }
  }
</style>