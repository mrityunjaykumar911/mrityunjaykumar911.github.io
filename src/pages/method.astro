---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { withBase } from '../lib/url';

const homeHref = withBase('/');
const paperHref = withBase('/research/executable-evidence-public-resumes.pdf');
const diagramSrc = withBase('/research/llm-tdd-loop.png');
const selectiveOptimizationSrc = withBase('/research/selective-optimization.png');
const tlaSpecHref = withBase('/research/ResumePublication.tla');
const year = new Date().getFullYear();
---

<Base
  title="How I Work | First Principles, Intuition, and Execution"
  description="A Senior ML Engineer's approach to turning ambiguous systems into testable, production-ready evidence."
  canonicalPath="/method.html"
>
  <header class="method-header" id="top">
    <a class="method-wordmark" href={homeHref} aria-label="Return to portfolio">
      <span class="wordmark-mark">MK</span>
      <span>
        <strong>Mrityunjay Kumar</strong>
        <small>Applied science · ML systems</small>
      </span>
    </a>
    <a class="back-link" href={homeHref}>
      Portfolio <Icon name="arrow-up-right" size={15} />
    </a>
  </header>

  <main id="main" class="method-page">
    <section class="method-hero" aria-labelledby="method-title">
      <div class="hero-copy">
        <p class="eyebrow">Field note · Applied science</p>
        <h1 id="method-title">First principles make intuition executable.</h1>
        <p class="hero-lede">
          I work at Microsoft as a <strong>Senior ML Engineer</strong>: understand the model,
          understand the system, and own what reaches production.
        </p>
      </div>

      <aside class="position-note" aria-label="Working position">
        <p class="mono-label">My operating premise</p>
        <p>
          Intuition is compressed evidence. I build it by reducing ambiguity to observable
          state, testing the assumptions that matter, and carrying the result through deployment.
        </p>
      </aside>
    </section>

    <section class="evidence-band" aria-label="Measured outcomes from this page">
      <div>
        <strong>65.3%</strong>
        <span>less text in the desktop fold</span>
      </div>
      <div>
        <strong>27 to 0</strong>
        <span>undersized desktop text nodes</span>
      </div>
      <div>
        <strong>22</strong>
        <span>executed browser cases</span>
      </div>
      <div>
        <strong>18</strong>
        <span>commits studied longitudinally</span>
      </div>
    </section>

    <section class="method-section principles" aria-labelledby="principles-title">
      <div class="section-intro">
        <p class="eyebrow">The reasoning model</p>
        <h2 id="principles-title">From first principles to production evidence.</h2>
        <p>
          The goal is not to ask an LLM for a finished answer. The goal is to create a
          sequence in which each uncertain choice becomes inspectable, falsifiable, and
          cheaper to revise.
        </p>
      </div>

      <ol class="principle-list">
        <li>
          <span class="principle-index">01</span>
          <div>
            <h3>Reconstruct state before generating.</h3>
            <p>
              Facts, provenance, and public boundaries are modeled before prose or layout.
              The model can reorganize approved evidence; it cannot silently invent it.
            </p>
          </div>
        </li>
        <li>
          <span class="principle-index">02</span>
          <div>
            <h3>Turn judgment into constraints.</h3>
            <p>
              Feedback such as "this feels misaligned" becomes a geometry assertion.
              Human intent steers the work; executable checks retain that intent.
            </p>
          </div>
        </li>
        <li>
          <span class="principle-index">03</span>
          <div>
            <h3>Triangulate instead of trusting one score.</h3>
            <p>
              Semantics, typography, geometry, responsive safety, privacy, and pixels answer
              different questions. Agreement is evidence; disagreement is a debugging lead.
            </p>
          </div>
        </li>
        <li>
          <span class="principle-index">04</span>
          <div>
            <h3>Close the loop on the live artifact.</h3>
            <p>
              A local pass is incomplete. Build output, deployment state, cache behavior,
              crawler views, and the page a reader actually receives belong to the system.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <section class="verification-section" aria-labelledby="verification-title">
      <div class="verification-copy">
        <p class="eyebrow">TLA+ · selective optimization</p>
        <h2 id="verification-title">Verify the protocol. Optimize the surface.</h2>
        <p>
          AutoMan's core idea is a useful division of labor: establish a verified baseline,
          then spend human effort where optimization matters. Here, TLA+ models the
          correctness-sensitive publication protocol while Astro and CSS remain deliberately
          hand-optimized for readers.
        </p>
        <a class="spec-link" href={tlaSpecHref} target="_blank" rel="noreferrer">
          Read the TLA+ model <Icon name="file" size={16} />
        </a>
      </div>

      <figure>
        <img
          src={selectiveOptimizationSrc}
          alt="Flow from public claim invariants through TLA plus model checking, selective Astro and CSS optimization, Playwright refinement checks, and deployment"
          width="600"
          height="2400"
          loading="lazy"
        />
      </figure>

      <div class="verification-results" aria-label="TLA plus model-checking results">
        <div><strong>5</strong><span>safety invariants</span></div>
        <div><strong>30</strong><span>reachable states</span></div>
        <div><strong>6</strong><span>maximum search depth</span></div>
        <div><strong>3/3</strong><span>mutants rejected</span></div>
      </div>

      <p class="verification-boundary">
        This is specification-guided selective optimization, not AutoMan's end-to-end
        refinement proof. TLC verifies the abstract publication state machine. Playwright
        checks that the manually optimized implementation preserves its observable contracts.
      </p>
    </section>

    <section class="flow-section" aria-labelledby="flow-title">
      <div class="flow-copy">
        <p class="eyebrow">Human · LLM · evidence</p>
        <h2 id="flow-title">The model proposes. The evidence decides.</h2>
        <p>
          This is a bounded collaboration loop. A focused failure returns concrete evidence
          to the next edit. Passing locally widens the check to the full browser suite, static
          build, and deployed page.
        </p>
      </div>
      <figure>
        <img
          src={diagramSrc}
          alt="Flow from human intent through a bounded LLM edit, focused checks, full browser tests, deployment, and live verification"
          width="1510"
          height="1718"
          loading="lazy"
        />
        <figcaption>Each accepted change leaves behind an executable reason.</figcaption>
      </figure>
    </section>

    <section class="theory-section" aria-labelledby="theory-title">
      <div class="section-intro">
        <p class="eyebrow">Theory into practice</p>
        <h2 id="theory-title">Ideas I borrow, boundaries I keep.</h2>
      </div>

      <div class="theory-grid">
        <article>
          <p class="mono-label">Provenance</p>
          <h3>Reconcile evidence before rendering.</h3>
          <p>
            Structured state reconciliation inspires the separation of approved facts,
            human intent, and generated presentation. A fluent output is not a source.
          </p>
        </article>
        <article>
          <p class="mono-label">Human checkpoint</p>
          <h3>Guardrails reduce risk; review owns truth.</h3>
          <p>
            Prompt rules narrow the search space, but factual approval remains human.
            Tests catch drift after approval; they do not certify a career claim.
          </p>
        </article>
        <article>
          <p class="mono-label">Steerability</p>
          <h3>Compile feedback into durable constraints.</h3>
          <p>
            Natural-language intent is indirect. Turning a decision into a test makes the
            desired behavior legible, repeatable, and independent of the next prompt.
          </p>
        </article>
        <article>
          <p class="mono-label">Multi-metric evaluation</p>
          <h3>Do not hide disagreement in one score.</h3>
          <p>
            A page can have zero overflow and still be hard to scan. Independent measures
            expose different failure families instead of manufacturing a quality badge.
          </p>
        </article>
      </div>
    </section>

    <section class="boundary-section" aria-labelledby="boundary-title">
      <div>
        <p class="eyebrow">Claim boundary</p>
        <h2 id="boundary-title">This verifies presentation, not people.</h2>
      </div>
      <p>
        The method can show that approved evidence is stable, legible, accessible, and
        consistently published. It cannot prove that a claim is true, predict recruiter
        behavior, rank candidates fairly, or replace human judgment. Those are different
        scientific questions and require different experiments.
      </p>
    </section>

    <section class="paper-section" aria-labelledby="paper-title">
      <div>
        <p class="eyebrow">Five-page case study</p>
        <h2 id="paper-title">From Resume Claims to Browser Contracts</h2>
        <p>
          The paper documents the matched Playwright study, visual x-rays, 18-commit trace,
          methodology, limitations, and implementation excerpts.
        </p>
      </div>
      <a class="paper-link" href={paperHref} target="_blank" rel="noreferrer">
        Read the paper <Icon name="file" size={17} />
      </a>
    </section>
  </main>

  <SiteFooter name="Mrityunjay Kumar" year={year} />
</Base>

<style>
  .method-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(18px) saturate(1.25);
  }

  .method-wordmark,
  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }

  .method-wordmark {
    gap: 11px;
  }

  .method-wordmark > span:last-child {
    display: grid;
    line-height: 1.15;
  }

  .method-wordmark strong {
    font-family: var(--display);
    font-size: 15px;
    font-weight: 650;
  }

  .method-wordmark small {
    margin-top: 3px;
    color: var(--ink-faint);
    font-size: 13px;
  }

  .wordmark-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--ink);
    color: #fff;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 600;
  }

  .back-link {
    gap: 7px;
    color: var(--ink-soft);
    font-size: 14px;
    font-weight: 550;
  }

  .method-hero,
  .method-section,
  .verification-section,
  .flow-section,
  .theory-section,
  .boundary-section,
  .paper-section {
    padding-inline: var(--gutter);
  }

  .method-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    gap: clamp(48px, 8vw, 120px);
    align-items: center;
    min-height: min(720px, calc(100vh - 68px));
    padding-block: clamp(72px, 10vh, 112px) clamp(64px, 8vh, 96px);
  }

  .hero-copy {
    max-width: 900px;
  }

  .eyebrow {
    margin-bottom: 22px;
    color: var(--accent);
  }

  h1,
  h2,
  h3 {
    font-family: var(--display);
  }

  h1 {
    max-width: 13ch;
    font-size: clamp(50px, 6.4vw, 92px);
    font-weight: 680;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero-lede {
    max-width: 64ch;
    margin-top: 34px;
    color: var(--ink-soft);
    font-size: clamp(18px, 1.45vw, 22px);
    line-height: 1.55;
  }

  .hero-lede strong {
    color: var(--ink);
    font-weight: 630;
  }

  .position-note {
    padding-top: 22px;
    border-top: 1px solid var(--line-strong);
  }

  .position-note .mono-label {
    margin-bottom: 14px;
    color: var(--accent);
  }

  .position-note p:last-child {
    color: var(--ink-soft);
    font-size: 16px;
  }

  .evidence-band {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 0 var(--gutter);
    border-block: 1px solid var(--line);
    background: var(--panel);
  }

  .evidence-band > div {
    display: grid;
    align-content: center;
    min-height: 132px;
    padding: 24px 28px;
    border-left: 1px solid var(--line);
  }

  .evidence-band > div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .evidence-band strong {
    color: var(--accent);
    font-size: 24px;
    line-height: 1.1;
  }

  .evidence-band span {
    margin-top: 7px;
    color: var(--ink-soft);
    font-size: 14px;
  }

  .method-section,
  .theory-section {
    padding-block: clamp(88px, 10vw, 144px);
  }

  .principles {
    display: grid;
    grid-template-columns: minmax(260px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(56px, 9vw, 140px);
  }

  .section-intro h2,
  .flow-copy h2,
  .boundary-section h2,
  .paper-section h2 {
    font-size: clamp(34px, 4vw, 54px);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .section-intro > p:last-child,
  .flow-copy > p:last-child,
  .paper-section > div > p:last-child {
    margin-top: 22px;
    color: var(--ink-soft);
    font-size: 17px;
  }

  .principle-list {
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .principle-list li {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 20px;
    padding: 30px 0;
    border-bottom: 1px solid var(--line);
  }

  .principle-index {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 13px;
  }

  .principle-list h3,
  .theory-grid h3 {
    font-size: 22px;
    line-height: 1.2;
  }

  .principle-list p,
  .theory-grid article > p:last-child {
    margin-top: 10px;
    color: var(--ink-soft);
  }

  .flow-section {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(56px, 8vw, 120px);
    align-items: center;
    padding-block: clamp(80px, 9vw, 128px);
    background: var(--ink-deep);
    color: #fff;
  }

  .verification-section {
    display: grid;
    grid-template-columns: minmax(300px, 0.8fr) minmax(260px, 0.55fr);
    gap: clamp(52px, 8vw, 120px);
    align-items: center;
    padding-block: clamp(88px, 10vw, 144px);
    border-top: 1px solid var(--line);
    background: var(--panel);
  }

  .verification-copy h2 {
    max-width: 12ch;
    font-size: clamp(34px, 4vw, 54px);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .verification-copy > p:not(.eyebrow) {
    max-width: 62ch;
    margin-top: 22px;
    color: var(--ink-soft);
    font-size: 17px;
  }

  .spec-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    color: var(--ink);
    font-weight: 620;
    text-decoration-color: var(--accent);
    text-underline-offset: 5px;
  }

  .verification-section figure {
    margin: 0;
  }

  .verification-section figure img {
    width: min(100%, 340px);
    max-height: 680px;
    margin-inline: auto;
    object-fit: contain;
  }

  .verification-results {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--line-strong);
  }

  .verification-results > div {
    display: grid;
    padding: 24px;
    border-left: 1px solid var(--line);
  }

  .verification-results > div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .verification-results strong {
    color: var(--accent);
    font-size: 24px;
  }

  .verification-results span {
    margin-top: 6px;
    color: var(--ink-soft);
    font-size: 14px;
  }

  .verification-boundary {
    grid-column: 1 / -1;
    max-width: 92ch;
    color: var(--ink-soft);
    font-size: 14px;
  }

  .flow-copy .eyebrow {
    color: var(--accent-on-dark);
  }

  .flow-copy > p:last-child {
    color: rgba(255, 255, 255, 0.68);
  }

  .flow-section figure {
    margin: 0;
  }

  .flow-section img {
    width: min(100%, 620px);
    margin-inline: auto;
    background: #fff;
  }

  .flow-section figcaption {
    margin-top: 14px;
    color: rgba(255, 255, 255, 0.54);
    font-size: 13px;
    text-align: center;
  }

  .theory-section .section-intro {
    max-width: 780px;
    margin-bottom: 58px;
  }

  .theory-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line-strong);
  }

  .theory-grid article {
    min-height: 250px;
    padding: 34px 34px 34px 0;
    border-bottom: 1px solid var(--line);
  }

  .theory-grid article:nth-child(even) {
    padding-right: 0;
    padding-left: 34px;
    border-left: 1px solid var(--line);
  }

  .theory-grid .mono-label {
    margin-bottom: 22px;
    color: var(--accent);
  }

  .boundary-section {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(56px, 9vw, 140px);
    padding-block: clamp(76px, 8vw, 112px);
    border-top: 1px solid var(--line);
    background: var(--panel);
  }

  .boundary-section > p {
    align-self: end;
    color: var(--ink-soft);
    font-size: 19px;
  }

  .paper-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: end;
    padding-block: clamp(88px, 9vw, 128px);
  }

  .paper-section > div {
    max-width: 820px;
  }

  .paper-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 46px;
    padding: 0 20px;
    border: 1px solid var(--ink);
    border-radius: 6px;
    background: var(--ink);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .paper-link:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  @media (min-width: 1800px) {
    .method-header {
      min-height: 84px;
    }

    .method-hero {
      min-height: min(760px, calc(100vh - 140px));
    }

    .evidence-band > div {
      min-height: 160px;
    }
  }

  @media (max-width: 900px) {
    .method-hero,
    .principles,
    .verification-section,
    .flow-section,
    .boundary-section {
      grid-template-columns: 1fr;
    }

    .method-hero {
      min-height: auto;
    }

    .position-note {
      max-width: 620px;
    }

    .verification-section figure img {
      max-height: 560px;
    }

    .evidence-band {
      grid-template-columns: repeat(2, 1fr);
    }

    .verification-results {
      grid-template-columns: repeat(2, 1fr);
    }

    .verification-results > div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .verification-results > div:nth-child(4) {
      border-top: 1px solid var(--line);
    }

    .evidence-band > div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .evidence-band > div:nth-child(4) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 620px) {
    .method-wordmark > span:last-child {
      display: none;
    }

    h1 {
      font-size: 46px;
    }

    .method-hero {
      padding-block: 72px 64px;
    }

    .evidence-band {
      grid-template-columns: 1fr;
    }

    .evidence-band > div,
    .evidence-band > div:first-child,
    .evidence-band > div:nth-child(3) {
      min-height: 104px;
      padding: 22px 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .evidence-band > div:first-child {
      border-top: 0;
    }

    .theory-grid {
      grid-template-columns: 1fr;
    }

    .theory-grid article,
    .theory-grid article:nth-child(even) {
      min-height: auto;
      padding: 30px 0;
      border-left: 0;
    }

    .paper-section {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .paper-link {
      justify-self: start;
    }
  }
</style>