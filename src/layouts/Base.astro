---
import '../styles/global.css';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/azeret-mono';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Root-relative path to the social preview image. */
  image?: string;
  /** JSON-LD graph, serialised into a ld+json script tag. */
  jsonLd?: unknown;
  noindex?: boolean;
  canonicalPath?: string;
}

const {
  title,
  description,
  image = '/images/mrityunjay.jpg',
  jsonLd,
  noindex = false,
  canonicalPath,
} = Astro.props;

// Google Analytics 4. Override or disable via PUBLIC_GA_ID in the environment
// (set it empty to ship no analytics at all).
const gaId = import.meta.env.PUBLIC_GA_ID ?? 'G-2JMPRPCPBP';

const canonical = new URL(withBase(canonicalPath ?? Astro.url.pathname), Astro.site).href;
const socialImage = new URL(withBase(image), Astro.site).href;
const favicon = withBase('/favicon.ico');
const appleTouchIcon = withBase('/images/mrityunjay.jpg');
const sitemap = withBase('/sitemap-index.xml');
const llmsContext = withBase('/llms.txt');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={sitemap} />
    <link rel="alternate" type="text/plain" href={llmsContext} title="LLM context" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href={favicon} sizes="any" />
    <link rel="apple-touch-icon" href={appleTouchIcon} />

    <meta name="theme-color" content="#f6f8f5" />

    {/* The previous site had no social metadata at all — links to it unfurled
        as a bare URL. */}
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Mrityunjay Kumar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    {/* Google Analytics (gtag.js). */}
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`}
          />
        </>
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
