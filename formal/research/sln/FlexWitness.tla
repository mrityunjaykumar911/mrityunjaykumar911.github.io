}

(* Every rejected shape really is coupled somewhere. *)
Maximal ==
    \A w \in Witnesses :
        F!Used(w.base, w.width)[w.item] # F!Used(w.pert, w.width)[w.item]

(* And none of these witnessed shapes is admitted, i.e. we stay sound. *)
WitnessesRejected ==
    \A w \in Witnesses : ~F!Immobile(w.base, w.item)

VARIABLE tick
Init == tick = 0
Next == UNCHANGED tick
Spec == Init /\ [][Next]_tick
=============================================================================
