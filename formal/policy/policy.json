  "declassified": {
    "_comment": "sink -> sources treated as public/non-PII on the path to that sink. A declared SET, never inferred from a transformation. An encoding is not a declassifier.",
    "current": {},
    "fixed": {
      "index_html": [
        "profile_email"
      ],
      "latest_html": [
        "profile_email"
      ]
    }
  },
  "audited": {
    "_comment": "sinks some executable check actually opens. 'current' is what the existing Playwright suite asserts on; the two PDFs are absent, which is defect F2.",
    "current": [
      "index_html",
      "latest_html",
      "llms_txt",
      "robots_txt",
      "sitemap_index",
