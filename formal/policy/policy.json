  "overrides": {
    "_comment": "deliberate, documented exceptions in the fixed policy. A CV is expected to carry contact details; the point is that this becomes an explicit decision instead of an unexamined one.",
    "fixed": {
      "cv_pdf": {
        "allows_pii": true,
        "why": "a CV is contact material by definition; recorded so it is a decision, not an oversight"
      }
    }
  },
  "detectors": {
    "_comment": "how check_artifacts.py recognises each PII source in emitted bytes. Encodings are listed because the information survives them; matching only the literal form is defect F1.",
    "profile_email": {
      "kind": "email",
      "encodings": [
        "literal",
        "reversed",
        "base64",
        "html_entities",
        "percent"
      ]
    },
    "profile_phone": {
      "kind": "phone",
      "encodings": [
        "literal",
        "reversed",
        "spaced"
      ]
    }
  },
  "strips_local": {
    "_comment": "does the production build drop local-labelled sources, i.e. is the `import.meta.env.DEV &&` guard in src/data/resume.ts present. The mutant deletes it.",
    "current": true,
    "fixed": true
  }
}