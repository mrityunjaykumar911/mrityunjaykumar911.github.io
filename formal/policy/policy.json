      "path": "dist/cv/cv/MrityunjayKumarCV.pdf.html",
      "clearance": "public",
      "allows_pii": false,
      "flows": []
    },
    "cv_pdf": {
      "path": "dist/cv/MrityunjayKumar-CV.pdf",
      "clearance": "public",
      "allows_pii": false,
      "flows": [
        "resume_public",
        "profile_email",
        "profile_phone"
