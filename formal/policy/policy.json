{
  "_comment": [
    "Disclosure policy for mrityunjaykumar911.github.io.",
    "",
    "One source of truth, read by two things that must agree:",
    "  gen_policy_tla.py  -> Policy*.tla, the abstract model TLC checks",
    "  check_artifacts.py -> the concrete check over the bytes in dist/",
    "",
    "'current' is the repository as it stands and is EXPECTED TO FAIL, on the two",
    "defects the check found (F1, F2 in DESIGN.md). 'fixed' is the same policy after",
    "the two remediations and is expected to pass. Keeping both means the model",
    "demonstrates the defects rather than describing them.",
    "",
    "audience lattice: public < flagged < local.  pii is orthogonal."
  ],
  "sources": {
    "resume_public": {
      "aud": "public",
      "pii": false,
      "from": "src/data/resume.yaml (minus profile.email)"
    },
    "profile_email": {
      "aud": "public",
      "pii": true,
      "from": "src/data/resume.yaml profile.email"
    },
    "profile_phone": {
      "aud": "public",
      "pii": true,
      "from": "phone number embedded in the CV PDF"
    },
    "resume_latest": {
      "aud": "flagged",
      "pii": false,
      "from": "src/data/resume.latest.yaml"
    },
    "resume_local": {
      "aud": "local",
      "pii": false,
      "from": "src/data/resume.local.yaml (git-ignored)"
    }
  },
  "sinks": {
    "index_html": {
      "path": "dist/index.html",
      "clearance": "public",
      "allows_pii": false,
      "flows": [
        "resume_public",
        "profile_email"
      ]
    },
    "latest_html": {
      "path": "dist/latest.html",
      "clearance": "flagged",
      "allows_pii": false,
      "flows": [
        "resume_public",
        "profile_email",
        "resume_latest"
      ]
    },
    "llms_txt": {
      "path": "dist/llms.txt",
      "clearance": "public",
      "allows_pii": false,
      "flows": [
        "resume_public"
      ]
    },
    "robots_txt": {
      "path": "dist/robots.txt",
      "clearance": "public",
      "allows_pii": false,
      "flows": []
    },
    "sitemap_index": {
