# build output
dist/
.astro/

# dependencies
node_modules/
.tools/
formal/states/
formal/**/states/
states/

# local interpreter/editor state
__pycache__/
*.py[cod]
.venv/
.vscode/settings.json
.vscode/tasks.json

# Playwright output
playwright-report/
playwright-report-vqa/
test-results/

# local-only résumé overlay — current-employer detail that must NOT be
# published or committed. Loaded only by `astro dev` with ?preview.
src/data/resume.local.yaml

# LaTeX build intermediates
paper/*.aux
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.toc

# raw, unredacted study screenshots (may contain identifiable resume content)
paper/figures/legacy-desktop.png
paper/figures/legacy-mobile.png
paper/figures/modern-desktop.png
paper/figures/modern-mobile.png

# local WebCode2M corpus extracts; retain only aggregate research results
formal/research/sln/pages.json
formal/research/sln/containers.json

# transient review/debug screenshots
paper/review-*.png
paper/reviewed-*.png
paper/revised-*.png
paper/tla-*.png

# misc
*.log
.DS_Store
.env
.env.*
!.env.example
