{
  "name": "deck2short-e2e",
  "private": true,
  "scripts": {
    "build": "python3 -m deck2short.preview .d2s/props.json -o out/storyboard.html",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "test:e2e:ui": "npm run build && playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
