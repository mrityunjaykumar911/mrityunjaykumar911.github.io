# Copy to .env for local development; .env is git-ignored.
# These are build-time settings. Changing them requires rebuilding dist/.
# Never put secrets in PUBLIC_* variables or in files under public/.

# Canonical URL used by metadata, links, base paths, and sitemap generation.
SITE_URL=https://mrityunjaykumar911.github.io

# Subpath deployments are supported too:
# SITE_URL=https://www3.cs.stonybrook.edu/~mrkumar/

# Existing analytics identifier. Leave the value empty to disable analytics.
PUBLIC_GA_ID=G-2JMPRPCPBP

# Optional hostname allowed by the local development server; not a URL.
# DEV_ALLOWED_HOST=preview.example.com